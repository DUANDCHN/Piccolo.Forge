            <SolidColorBrush x:Key="Forge.Slider.Thumb" Color="#FFF7F8FA" />  <!-- 回落自 *.background -->
            <SolidColorBrush x:Key="Forge.Slider.ThumbBorder" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Slider.Tick" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Progress.Bar" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Progress.Track" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Progress.Passed" Color="#FF55A76A" />
            <SolidColorBrush x:Key="Forge.Progress.Failed" Color="#FFE55765" />
            <SolidColorBrush x:Key="Forge.ToolTip.Background" Color="#FF27282E" />
            <SolidColorBrush x:Key="Forge.ToolTip.Foreground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.ToolTip.Border" Color="#FF27282E" />
            <SolidColorBrush x:Key="Forge.Link.Foreground" Color="#FF315FBD" />
            <SolidColorBrush x:Key="Forge.Label.Error" Color="#FFDB3B4B" />
            <SolidColorBrush x:Key="Forge.Label.Warning" Color="#FFA46704" />
            <SolidColorBrush x:Key="Forge.Split.AccentSeparator" Color="#FF88ADF7" />
            <SolidColorBrush x:Key="Forge.Table.GridLine" Color="#FFEBECF0" />
            <SolidColorBrush x:Key="Forge.Table.Stripe" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Table.HeaderSeparator" Color="#FFEBECF0" />  <!-- 回落自 TableHeader.bottomSeparatorColor -->
            <SolidColorBrush x:Key="Forge.Notification.Background" Color="#FFFFFFFF" />  <!-- 上游 JSON 未定义，取自 有意偏离上游：亮色档改浅底，暗色档仍用 Notification.background -->
            <SolidColorBrush x:Key="Forge.Notification.Border" Color="#FFB9BDC9" />  <!-- 上游 JSON 未定义，取自 亮色档用弹出层的边框色，暗色档用上游 Notification.borderColor -->
            <SolidColorBrush x:Key="Forge.Notification.Link" Color="#FF88ADF7" />
            <SolidColorBrush x:Key="Forge.Notification.IconHover" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Forge.Notification.Shadow" Color="#10808080" />
            <SolidColorBrush x:Key="Forge.Window.Background" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Window.Border" Color="#FFEBECF0" />
            <SolidColorBrush x:Key="Forge.Window.TitleBarBackground" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Scrim" Color="#40000000" />  <!-- 上游 JSON 未定义，取自 上游无模态遮罩色，自定 -->
            <SolidColorBrush x:Key="Forge.Banner.InfoBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Banner.InfoBorder" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Banner.WarnBackground" Color="#FFFEE6B1" />
            <SolidColorBrush x:Key="Forge.Banner.WarnBorder" Color="#FFFED277" />
            <SolidColorBrush x:Key="Forge.Banner.ErrorBackground" Color="#FFFAD4D8" />
            <SolidColorBrush x:Key="Forge.Banner.ErrorBorder" Color="#FFF2B6BB" />
            <SolidColorBrush x:Key="Forge.Banner.Foreground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorBackground" Color="#FFFFF2F3" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorBorder" Color="#FFED99A1" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Validation.WarningBackground" Color="#FFFFF5DB" />
            <SolidColorBrush x:Key="Forge.Validation.WarningBorder" Color="#FFFDBD3D" />
            <SolidColorBrush x:Key="Forge.Validation.WarningForeground" Color="#FF000000" />
        </ResourceDictionary>

