<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      经典档（IntelliJ expUI）色板。**本文件由 scripts/gen-forge-palette.py 生成，不要手改。**
      色值逐条来自上游 expUI_{light,dark}.theme.json（Forge 仓 third_party/intellij-community），
      改色请改生成器里的 MAP，然后重跑。
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Forge.Text.Primary" Color="#FF000000" />  <!-- 继承自父主题的 *.foreground -->
            <SolidColorBrush x:Key="Forge.Text.Secondary" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Button.Background" Color="#FFF7F8FA" />  <!-- 回落自 *.background -->
            <SolidColorBrush x:Key="Forge.Button.Border" Color="#FFC9CCD6" />
            <SolidColorBrush x:Key="Forge.Button.Accent.Background" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Button.Accent.Foreground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Button.Disabled.Foreground" Color="#FFA8ADBD" />
            <SolidColorBrush x:Key="Forge.Button.Disabled.Border" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Overlay.Hover" Color="#12000000" />
            <SolidColorBrush x:Key="Forge.Overlay.Pressed" Color="#1D000000" />
            <SolidColorBrush x:Key="Forge.Focus.Ring" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Input.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Input.Border" Color="#FFC9CCD6" />
            <SolidColorBrush x:Key="Forge.Input.HoverBorder" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Input.FocusedBorder" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Input.Disabled.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Input.Disabled.Border" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Input.Placeholder" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Input.SelectionBackground" Color="#FFD4E2FF" />
            <SolidColorBrush x:Key="Forge.Input.SelectionForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Input.Error" Color="#FFDB3B4B" />
            <SolidColorBrush x:Key="Forge.Input.Warning" Color="#FFFFAF0F" />
            <SolidColorBrush x:Key="Forge.ComboBox.Background" Color="#FFFFFFFF" />  <!-- 回落自 ComboBox.ArrowButton.nonEditableBackground -->
            <SolidColorBrush x:Key="Forge.ComboBox.EditableBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.ComboBox.Disabled.Background" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Popup.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Popup.Border" Color="#FFB9BDC9" />
            <SolidColorBrush x:Key="Forge.Item.HoverBackground" Color="#FFEDF3FF" />  <!-- 回落自 *.hoverBackground -->
            <SolidColorBrush x:Key="Forge.Item.SelectedBackground" Color="#FFD4E2FF" />
            <SolidColorBrush x:Key="Forge.Item.SelectedForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Item.SelectedInactiveBackground" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.ScrollBar.Thumb" Color="#33737373" />  <!-- 继承自父主题的 ScrollBar.Transparent.thumbColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbBorder" Color="#33595959" />  <!-- 继承自父主题的 ScrollBar.Transparent.thumbBorderColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbHover" Color="#47737373" />  <!-- 继承自父主题的 ScrollBar.Transparent.hoverThumbColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbHoverBorder" Color="#47595959" />  <!-- 继承自父主题的 ScrollBar.Transparent.hoverThumbBorderColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.Track" Color="#00808080" />  <!-- 继承自父主题的 ScrollBar.Transparent.trackColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.TrackHover" Color="#1A808080" />  <!-- 继承自父主题的 ScrollBar.Transparent.hoverTrackColor -->
            <SolidColorBrush x:Key="Forge.Menu.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Menu.Border" Color="#FFB9BDC9" />
            <SolidColorBrush x:Key="Forge.Menu.Separator" Color="#FFEBECF0" />  <!-- 回落自 *.separatorColor -->
            <SolidColorBrush x:Key="Forge.MenuItem.SelectedBackground" Color="#FFD4E2FF" />
            <SolidColorBrush x:Key="Forge.MenuItem.SelectedForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.MenuItem.Accelerator" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.MenuItem.AcceleratorSelected" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.MenuItem.Disabled" Color="#FFA8ADBD" />
            <SolidColorBrush x:Key="Forge.Check.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Check.Border" Color="#FFA8ADBD" />
            <SolidColorBrush x:Key="Forge.Check.SelectedBackground" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Check.SelectedBorder" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Check.Glyph" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Background" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Border" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Glyph" Color="#FFC9CCD6" />
            <SolidColorBrush x:Key="Forge.Group.Separator" Color="#FFEBECF0" />  <!-- 回落自 *.separatorColor -->
            <!-- 经典档选中态是**下划线**，不是块底（Rider 实机对照：经典画线、Islands 画药丸）。
                 底留透明，选中的表达全交给下面那条线。 -->
            <SolidColorBrush x:Key="Forge.Tab.SelectedBackground" Color="#00000000" />
            <SolidColorBrush x:Key="Forge.Tab.Underline" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Tab.HoverBackground" Color="#FFEBECF0" />
            <SolidColorBrush x:Key="Forge.Tab.ContentBorder" Color="#FFEBECF0" />
