<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Islands 档色板。**本文件由 scripts/gen-forge-palette.py 生成，不要手改。**
      来源：上游 themes/islands/ManyIslands{Light,Dark}.theme.json。
      Islands 是 expUI 的一层皮肤（parentTheme=Experimental*），控件结构与经典档完全相同，
      **只有色板不同** —— 所以 Controls/ 下的模板两档共用，别为 Islands 另写模板。
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Forge.Text.Primary" Color="#FF000000" />  <!-- 继承自父主题的 *.foreground -->
            <SolidColorBrush x:Key="Forge.Text.Secondary" Color="#FF73767C" />
            <SolidColorBrush x:Key="Forge.Button.Background" Color="#FFF7F8F9" />  <!-- 回落自 *.background -->
            <SolidColorBrush x:Key="Forge.Button.Border" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Button.Accent.Background" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.Button.Accent.Foreground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Button.Disabled.Foreground" Color="#FF9FA2A8" />
            <SolidColorBrush x:Key="Forge.Button.Disabled.Border" Color="#FFDDDFE4" />
            <SolidColorBrush x:Key="Forge.Overlay.Hover" Color="#12000000" />
            <SolidColorBrush x:Key="Forge.Overlay.Pressed" Color="#20000000" />
            <SolidColorBrush x:Key="Forge.Focus.Ring" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.Input.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Input.Border" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Input.HoverBorder" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.Input.FocusedBorder" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.Input.Disabled.Background" Color="#FFF7F8F9" />
            <SolidColorBrush x:Key="Forge.Input.Disabled.Border" Color="#FFDDDFE4" />
            <SolidColorBrush x:Key="Forge.Input.Placeholder" Color="#FF73767C" />
            <SolidColorBrush x:Key="Forge.Input.SelectionBackground" Color="#FFD0DFFE" />
            <SolidColorBrush x:Key="Forge.Input.SelectionForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Input.Error" Color="#FFE4656E" />
            <SolidColorBrush x:Key="Forge.Input.Warning" Color="#FFC28013" />
            <SolidColorBrush x:Key="Forge.ComboBox.Background" Color="#FFFFFFFF" />  <!-- 回落自 ComboBox.ArrowButton.nonEditableBackground -->
            <SolidColorBrush x:Key="Forge.ComboBox.EditableBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.ComboBox.Disabled.Background" Color="#FFF7F8F9" />
            <SolidColorBrush x:Key="Forge.Popup.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Popup.Border" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Item.HoverBackground" Color="#08000000" />
            <SolidColorBrush x:Key="Forge.Item.SelectedBackground" Color="#FFD0DFFE" />
            <SolidColorBrush x:Key="Forge.Item.SelectedForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Item.SelectedInactiveBackground" Color="#FFE9EAEE" />
            <!-- ⚠ 滑块的两档填色是**刻意偏离上游**，别当漂移改回去。
                 上游原值：浅色 #33737373（20% 不透明度）、深色 #47A6A6A6 / Islands #59808080。
                 那是 IDE 里「浮在代码上、不抢注意力」的分寸；本软件的表格与面板是白底密排数据，
                 20% 的灰压在白底上算出来约 #E3E3E3，实机就是看不见 —— 宿主 2026-08-28 反馈的正是这条。
                 现值把常态抬到 55%~65%、悬停再高一档，并把 ThumbMargin 由 3 收到 2（滑块 6px → 8px）。
                 数值是渲图比对后定的（现状 / 候选A 40% / 候选B 55%，选了 B），不是拍脑袋。
                 ⚠ 常态仍**不画描边**：试过给常态加 1px，描边色与填充色太近，4× 放大都看不出来，
                   白添一个说不清作用的参数。描边只在悬停档出现，那两个键仍取上游。 -->
            <SolidColorBrush x:Key="Forge.ScrollBar.Thumb" Color="#8C737373" />
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbBorder" Color="#33595959" />  <!-- 继承自父主题的 ScrollBar.Transparent.thumbBorderColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbHover" Color="#B3737373" />
            <SolidColorBrush x:Key="Forge.ScrollBar.ThumbHoverBorder" Color="#47595959" />  <!-- 继承自父主题的 ScrollBar.Transparent.hoverThumbBorderColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.Track" Color="#00808080" />  <!-- 继承自父主题的 ScrollBar.Transparent.trackColor -->
            <SolidColorBrush x:Key="Forge.ScrollBar.TrackHover" Color="#1A808080" />  <!-- 继承自父主题的 ScrollBar.Transparent.hoverTrackColor -->
            <SolidColorBrush x:Key="Forge.Menu.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Menu.Border" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Menu.Separator" Color="#FFE9EAEE" />  <!-- 回落自 *.separatorColor -->
            <SolidColorBrush x:Key="Forge.MenuItem.SelectedBackground" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.MenuItem.SelectedForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.MenuItem.Accelerator" Color="#FF73767C" />
            <SolidColorBrush x:Key="Forge.MenuItem.AcceleratorSelected" Color="#FF73767C" />
            <SolidColorBrush x:Key="Forge.MenuItem.Disabled" Color="#FF9FA2A8" />
            <SolidColorBrush x:Key="Forge.Check.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Check.Border" Color="#FFA8ADBD" />
            <SolidColorBrush x:Key="Forge.Check.SelectedBackground" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Check.SelectedBorder" Color="#FF3574F0" />
            <SolidColorBrush x:Key="Forge.Check.Glyph" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Background" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Border" Color="#FFDFE1E5" />
            <SolidColorBrush x:Key="Forge.Check.Disabled.Glyph" Color="#FFC9CCD6" />
            <SolidColorBrush x:Key="Forge.Group.Separator" Color="#FFE9EAEE" />  <!-- 回落自 *.separatorColor -->
            <!-- Islands 档选中态是**药丸底**，不画下划线（Rider 实机对照）。 -->
            <SolidColorBrush x:Key="Forge.Tab.SelectedBackground" Color="#FFE3EBFE" />
            <SolidColorBrush x:Key="Forge.Tab.Underline" Color="#00000000" />
            <SolidColorBrush x:Key="Forge.Tab.HoverBackground" Color="#12000000" />
            <SolidColorBrush x:Key="Forge.Tab.ContentBorder" Color="#FFE9EAEE" />
            <SolidColorBrush x:Key="Forge.Slider.Track" Color="#FFC9CCD6" />
            <SolidColorBrush x:Key="Forge.Slider.Thumb" Color="#FFF7F8F9" />  <!-- 回落自 *.background -->
            <SolidColorBrush x:Key="Forge.Slider.ThumbBorder" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Slider.Tick" Color="#FF818594" />
            <SolidColorBrush x:Key="Forge.Progress.Bar" Color="#FF3871E1" />
            <SolidColorBrush x:Key="Forge.Progress.Track" Color="#FFDDDFE4" />
            <SolidColorBrush x:Key="Forge.Progress.Passed" Color="#FF4E9D6C" />
            <SolidColorBrush x:Key="Forge.Progress.Failed" Color="#FFE4656E" />
            <SolidColorBrush x:Key="Forge.ToolTip.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.ToolTip.Foreground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.ToolTip.Border" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Link.Foreground" Color="#FF2F5EB9" />
            <SolidColorBrush x:Key="Forge.Label.Error" Color="#FFC54E58" />
            <SolidColorBrush x:Key="Forge.Label.Warning" Color="#FFA56906" />
            <SolidColorBrush x:Key="Forge.Split.AccentSeparator" Color="#45FFFFFF" />
            <SolidColorBrush x:Key="Forge.Table.GridLine" Color="#FFE9EAEE" />
            <SolidColorBrush x:Key="Forge.Table.Stripe" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Table.HeaderSeparator" Color="#FFE9EAEE" />  <!-- 回落自 TableHeader.bottomSeparatorColor -->
            <SolidColorBrush x:Key="Forge.Notification.Background" Color="#FFFFFFFF" />  <!-- 上游 JSON 未定义，取自 有意偏离上游：亮色档改浅底，暗色档仍用 Notification.background -->
            <SolidColorBrush x:Key="Forge.Notification.Border" Color="#FFB9BDC9" />  <!-- 上游 JSON 未定义，取自 亮色档用弹出层的边框色，暗色档用上游 Notification.borderColor -->
            <SolidColorBrush x:Key="Forge.Notification.Link" Color="#FF2F5EB9" />
            <SolidColorBrush x:Key="Forge.Notification.IconHover" Color="#12000000" />
            <SolidColorBrush x:Key="Forge.Notification.Shadow" Color="#10808080" />
            <SolidColorBrush x:Key="Forge.Window.Background" Color="#FFF7F8F9" />
            <SolidColorBrush x:Key="Forge.Window.Border" Color="#FFE9EAEE" />
            <SolidColorBrush x:Key="Forge.Window.TitleBarBackground" Color="#FFF7F8F9" />
            <SolidColorBrush x:Key="Forge.Scrim" Color="#40000000" />  <!-- 上游 JSON 未定义，取自 上游无模态遮罩色，自定 -->
            <SolidColorBrush x:Key="Forge.Banner.InfoBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Forge.Banner.InfoBorder" Color="#FFD1D3D9" />
            <SolidColorBrush x:Key="Forge.Banner.WarnBackground" Color="#FFFFF6E9" />
            <SolidColorBrush x:Key="Forge.Banner.WarnBorder" Color="#FFF4CD9A" />
            <SolidColorBrush x:Key="Forge.Banner.ErrorBackground" Color="#FFFFF6F5" />
            <SolidColorBrush x:Key="Forge.Banner.ErrorBorder" Color="#FFFFC4C5" />
            <SolidColorBrush x:Key="Forge.Banner.Foreground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorBackground" Color="#FFFFF6F5" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorBorder" Color="#FFFFC4C5" />
            <SolidColorBrush x:Key="Forge.Validation.ErrorForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="Forge.Validation.WarningBackground" Color="#FFFFF6E9" />
            <SolidColorBrush x:Key="Forge.Validation.WarningBorder" Color="#FFF4CD9A" />
            <SolidColorBrush x:Key="Forge.Validation.WarningForeground" Color="#FF000000" />
        </ResourceDictionary>

