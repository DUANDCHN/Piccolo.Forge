<Styles
    x:Class="Piccolo.Forge.Themes.Islands.ForgeIslandsShellTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  ★ 只有外壳（条带 / 停靠区 / 标题条 / 编辑器标签）与它用到的色板，**不含控件模板**。★

          给这种宿主用：已经有自己的基础主题（Fluent / Semi / 自研），只想要 IntelliJ 形态的停靠外壳。
          ⚠ 这时按钮、输入框那些**仍由宿主的基础主题画**，与外壳不同源，观感会有出入 —— 这是取舍本身，
            不是缺陷。要观感统一就用 ForgeIslandsTheme 那个全套。

          ⚠ 一个应用只能装一套基础主题。装了本入口，别再装 ForgeIslandsTheme：
            两者会抢同一批外壳 ControlTheme，谁赢取决于 Application.Styles 里的先后，且不报错。  -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Piccolo.Forge.Themes.Islands/Colors.axaml" />
                <ResourceInclude Source="avares://Piccolo.Forge.Themes.Islands/Shell.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
