<!--  Forge 文案：Русский（ru-RU）。键与 en-US.axaml 一一对应，缺键由英文回落。  -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Piccolo.Forge.Avalonia.Locales.ForgeLocale_ru_RU">
