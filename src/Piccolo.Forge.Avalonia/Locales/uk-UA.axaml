    <x:String x:Key="Forge.Strings.ViewModeDockPinned">Закріплено</x:String>
    <x:String x:Key="Forge.Strings.ViewModeDockUnpinned">Не закріплено</x:String>
    <x:String x:Key="Forge.Strings.ViewModeUndock">Відкріплено</x:String>
    <x:String x:Key="Forge.Strings.ViewModeFloat">Плаваюче</x:String>
    <x:String x:Key="Forge.Strings.ViewModeWindow">Вікно</x:String>
    <x:String x:Key="Forge.Strings.SideLeft">Ліворуч</x:String>
    <x:String x:Key="Forge.Strings.SideRight">Праворуч</x:String>
    <x:String x:Key="Forge.Strings.SideBottom">Знизу</x:String>
    <x:String x:Key="Forge.Strings.SideTop">Зверху</x:String>
    <x:String x:Key="Forge.Strings.HalfTop">Верх</x:String>
    <x:String x:Key="Forge.Strings.HalfBottom">Низ</x:String>
    <x:String x:Key="Forge.Strings.HalfLeft">Ліворуч</x:String>
    <x:String x:Key="Forge.Strings.HalfRight">Праворуч</x:String>
    <x:String x:Key="Forge.Strings.LocationFormat">{0} · {1}</x:String>
    <x:String x:Key="Forge.Strings.MoveToFormat">Перемістити до {0}</x:String>
    <x:String x:Key="Forge.Strings.CloseTab">Закрити</x:String>
    <x:String x:Key="Forge.Strings.CloseOtherTabs">Закрити інші вкладки</x:String>
    <x:String x:Key="Forge.Strings.CloseAllTabs">Закрити всі вкладки</x:String>
    <x:String x:Key="Forge.Strings.CloseTabsToTheLeft">Закрити вкладки ліворуч</x:String>
    <x:String x:Key="Forge.Strings.CloseTabsToTheRight">Закрити вкладки праворуч</x:String>
    <x:String x:Key="Forge.Strings.SplitRight">Розділити праворуч</x:String>
    <x:String x:Key="Forge.Strings.SplitAndMoveRight">Розділити та перемістити праворуч</x:String>
    <x:String x:Key="Forge.Strings.SplitDown">Розділити вниз</x:String>
    <x:String x:Key="Forge.Strings.SplitAndMoveDown">Розділити та перемістити вниз</x:String>
    <x:String x:Key="Forge.Strings.PinTab">Закріпити вкладку</x:String>
    <x:String x:Key="Forge.Strings.OpenTabInNewWindow">Відкрити в новому вікні</x:String>
    <x:String x:Key="Forge.Strings.DockButton">Закріпити</x:String>
    <x:String x:Key="Forge.Strings.OptionsButton">Параметри</x:String>
    <x:String x:Key="Forge.Strings.HideButton">Приховати</x:String>
    <x:String x:Key="Forge.Strings.MoreToolWindows">Інші вікна інструментів</x:String>
