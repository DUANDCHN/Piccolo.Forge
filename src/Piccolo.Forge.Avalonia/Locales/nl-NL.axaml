    <x:String x:Key="Forge.Strings.SplitAndMoveDown">Splitsen en naar onder verplaatsen</x:String>
    <x:String x:Key="Forge.Strings.PinTab">Tabblad vastzetten</x:String>
    <x:String x:Key="Forge.Strings.OpenTabInNewWindow">In nieuw venster openen</x:String>
    <x:String x:Key="Forge.Strings.DockButton">Docken</x:String>
    <x:String x:Key="Forge.Strings.OptionsButton">Opties</x:String>
    <x:String x:Key="Forge.Strings.HideButton">Verbergen</x:String>
    <x:String x:Key="Forge.Strings.MoreToolWindows">Meer gereedschapsvensters</x:String>
