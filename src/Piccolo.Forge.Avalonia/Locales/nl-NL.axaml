    <x:String x:Key="Forge.Strings.ViewModeUndock">Losgekoppeld</x:String>
    <x:String x:Key="Forge.Strings.ViewModeFloat">Zwevend</x:String>
    <x:String x:Key="Forge.Strings.ViewModeWindow">Venster</x:String>
