    <x:String x:Key="Forge.Strings.HalfBottom">Onder</x:String>
    <x:String x:Key="Forge.Strings.HalfLeft">Links</x:String>
    <x:String x:Key="Forge.Strings.HalfRight">Rechts</x:String>
    <x:String x:Key="Forge.Strings.LocationFormat">{0} · {1}</x:String>
