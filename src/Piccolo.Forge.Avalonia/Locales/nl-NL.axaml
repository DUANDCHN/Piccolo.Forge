    <x:String x:Key="Forge.Strings.CloseTab">Sluiten</x:String>
    <x:String x:Key="Forge.Strings.CloseOtherTabs">Andere tabbladen sluiten</x:String>
    <x:String x:Key="Forge.Strings.CloseAllTabs">Alle tabbladen sluiten</x:String>
