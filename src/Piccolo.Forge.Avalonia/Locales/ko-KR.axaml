<!--  Forge 文案：한국어（ko-KR）。键与 en-US.axaml 一一对应，缺键由英文回落。  -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="Forge.Strings.MoveTo">이동</x:String>
    <x:String x:Key="Forge.Strings.ViewMode">보기 모드</x:String>
