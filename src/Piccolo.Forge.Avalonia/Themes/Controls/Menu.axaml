<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:forge="using:Piccolo.Forge.Avalonia"
                    xmlns:themes="using:Piccolo.Forge.Themes">
    <!--
      Menu（顶栏）/ MenuItem / ContextMenu / MenuFlyoutPresenter。

      MenuItem 一个模板要顶四种形态，靠伪类切换，不是四个 ControlTheme：
        无伪类   普通项
        :icon    带图标（图标列**恒占位**，否则有图标和没图标的项文本对不齐）
        :toggle / :radio + :checked   勾选项（勾选标记占图标列）
        :separator                    分隔线（整项换成一条横线，不再是可点的项）
        :open                         子菜单已展开
      菜单栏里的项（Menu 的直接子项）另走 Forge.MenuBarItem —— 它横排、更紧凑、
      子菜单朝下弹；菜单面板里的项子菜单朝右弹。两者的模板结构不同，分开写。
    -->

    <!-- 快捷键提示那列的文本转换器（自定义槽优先，否则把 KeyGesture 渲染成键帽形）。
         声明成对象元素而非 x:Static 取单例：内部类型的静态成员 XamlIl 解析不到，
         对象元素同程序集内可用。无状态，一份够用。 -->
    <themes:ForgeAcceleratorTextConverter x:Key="Forge.AcceleratorTextConverter" />

    <!-- 菜单面板的外壳，Menu 的下拉、ContextMenu、MenuFlyout 共用。 -->
    <ControlTheme x:Key="Forge.MenuPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Forge.Menu.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Menu.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Popup.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.Menu.Padding}" />
    </ControlTheme>

    <!-- ══ 菜单面板里的项 ══ -->
    <ControlTheme x:Key="Forge.MenuItem" TargetType="MenuItem">
        <!-- 子菜单里的项继续用本主题（MenuItem 自己也是 ItemsControl）。 -->
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Forge.MenuItem}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- ⚠ 前景色必须**显式给一次**，不能靠继承。
             选中态把 Foreground 设成白色是设在 MenuItem 自己身上的，而它的子菜单就挂在它的
             模板里 —— 子项没有自己的值时会把这个白色**继承下去**，于是二级菜单在白底上一片空白
             （2026-08-26 宿主实机：亮色主题下二级子菜单"文字不见了"；无头量到三级项的
             Foreground=White）。给一个自己的值，继承链就在每一项这里断开。 -->
        <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Primary}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.MenuItem.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.MenuItem.Padding}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Forge.CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- 图标 / 勾选列。恒占位，见抬头。 -->
                        <Panel Grid.Column="0"
                               Width="{DynamicResource Forge.MenuItem.IconColumnWidth}"
                               VerticalAlignment="Center">
                            <ContentPresenter Name="PART_IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 勾选标记。自绘而非用字体图标：这一层不该依赖任何图标包。 -->
                            <Path Name="PART_CheckGlyph"
                                  Data="M 0 3.5 L 3 6.5 L 8.5 1"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  IsVisible="False"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>

                        <!-- 左侧图标列后留 5px；右侧叶项预留 24px，文字两侧空白保持接近。 -->
                        <ContentPresenter Grid.Column="1"
                                          Name="PART_HeaderPresenter"
                                          Margin="5,0,0,0"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />

                        <!-- 快捷键提示。比正文弱一档，与右边留出间距。 -->
                        <TextBlock Grid.Column="2"
                                   Name="PART_Accelerator"
                                   Foreground="{DynamicResource Forge.MenuItem.Accelerator}"
                                   Margin="24,0,0,0"
                                   IsVisible="False"
                                   VerticalAlignment="Center">
                            <!-- 显示什么由两路决定：宿主设过 ForgeMenu.GestureText 就用它，
                                 否则把 InputGesture 渲染成键帽形（Ctrl+OemComma → Ctrl+,）。
                                 ⚠ 原先是 Text="{TemplateBinding InputGesture}"，即把 KeyGesture.ToString()
                                   的枚举名原样示人——菜单里写着 Ctrl+OemComma，谁也认不出那是逗号。 -->
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Forge.AcceleratorTextConverter}">
                                    <Binding Path="(forge:ForgeMenu.GestureText)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="InputGesture" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 子菜单箭头连同左右间距占 24px，与叶项的右侧预留同宽。 -->
                        <Path Grid.Column="3"
                              Name="PART_SubMenuChevron"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.2"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Margin="16,0,4,0"
                              VerticalAlignment="Center" />

                        <Popup Name="PART_Popup"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                               PlacementTarget="{TemplateBinding}"
                               Placement="RightEdgeAlignedTop"
                               HorizontalOffset="2"
                               InheritsTransform="True"
                               WindowManagerAddShadowHint="False"
                               IsLightDismissEnabled="False">
                            <Border Theme="{StaticResource Forge.MenuPanelBorder}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- 高亮只跟随当前选中项，背景与文字同步切换；延迟关闭的旧子菜单不能继续留下蓝底。 -->
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.MenuItem.SelectedBackground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource Forge.MenuItem.SelectedForeground}" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Accelerator">
            <Setter Property="Foreground" Value="{DynamicResource Forge.MenuItem.AcceleratorSelected}" />
        </Style>

        <!-- 箭头默认在、无子项时隐掉；快捷键反过来。两者不会同时出现。 -->
        <Style Selector="^:empty /template/ Path#PART_SubMenuChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:empty /template/ TextBlock#PART_Accelerator">
            <!-- 保留原有右侧预留，与左侧图标列平衡；无快捷键也不能把文字挤到右边缘。 -->
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:checked /template/ Path#PART_CheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.MenuItem.Disabled}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 分隔项：整项换成一条线。padding 归零，否则线两端会缩进得比菜单边还多。 -->
        <Style Selector="^:separator">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="1" Margin="0,4"
                            Background="{DynamicResource Forge.Menu.Separator}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- ══ 菜单栏（顶栏）里的项 ══ 横排、更紧凑、子菜单朝下弹。 -->
    <ControlTheme x:Key="Forge.MenuBarItem" TargetType="MenuItem">
        <!-- 菜单栏项的下拉里是普通菜单项，不是菜单栏项。 -->
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Forge.MenuItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource Forge.MenuBarItem.Padding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Button.CornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <ContentPresenter Name="PART_HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <Popup Name="PART_Popup"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                               PlacementTarget="{TemplateBinding}"
                               Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="2"
                               InheritsTransform="True"
                               WindowManagerAddShadowHint="False"
                               IsLightDismissEnabled="True"
                               OverlayInputPassThroughElement="{Binding $parent[Menu]}">
                            <Border Theme="{StaticResource Forge.MenuPanelBorder}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- 菜单栏项用叠加反馈，不用选中蓝底 —— 蓝底在顶栏上太重，上游也是淡淡一层。 -->
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Overlay.Hover}" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Overlay.Pressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.MenuItem.Disabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Forge.Menu" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- 直接子项走菜单栏那套（横排、紧凑、朝下弹）。
             ⚠ 必须用 ItemContainerTheme，**不能**写 `^ > MenuItem` 这种子代选择器 ——
               ControlTheme 里不允许子代/后代选择器，而且它是**运行期**才抛
               InvalidOperationException（资源延迟构建），编译期一切正常。 -->
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Forge.MenuBarItem}" />
    </ControlTheme>

    <ControlTheme x:Key="Forge.ContextMenu" TargetType="ContextMenu">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Forge.MenuItem}" />
        <Setter Property="Background" Value="{DynamicResource Forge.Menu.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Menu.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Popup.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.Menu.Padding}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Forge.MenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource Forge.MenuItem}" />
        <Setter Property="Background" Value="{DynamicResource Forge.Menu.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Menu.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Popup.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.Menu.Padding}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Forge.Separator" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource Forge.Menu.Separator}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
