<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ComboBox + ComboBoxItem。边框与聚焦规则复用 Forge.Input.*，与 TextBox 同一套。
      ⚠ 不可编辑时用 Forge.ComboBox.Background（暗色下比输入框亮一档），可编辑时才用输入框底色 ——
        上游有意让不可编辑的更像按钮而非输入框（ComboBox.nonEditableBackground）。
    -->

    <ControlTheme x:Key="Forge.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="{DynamicResource Forge.Item.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.Item.Height}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 下拉项**不做圆角**：上游的列表项是通栏色块，圆角会在项之间露出底色缝。 -->
                <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Forge.CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Item.HoverBackground}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Item.SelectedBackground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Item.SelectedForeground}" />
        </Style>
        <!-- 选中且悬停仍用选中色，不叠加 —— 叠加会让"当前选中"这条读起来像另一种状态。 -->
        <Style Selector="^:selected:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Item.SelectedBackground}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Button.Disabled.Foreground}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Forge.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Forge.ComboBox.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Forge.Input.BorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Input.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.ComboBox.Padding}" />
        <Setter Property="MinWidth" Value="{DynamicResource Forge.Input.MinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.Input.MinHeight}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Forge.Input.Placeholder}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_FocusRing"
                        BorderBrush="Transparent"
                        BorderThickness="{DynamicResource Forge.Focus.RingThickness}"
                        CornerRadius="{DynamicResource Forge.Focus.RingCornerRadius}">
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Name="PART_Placeholder"
                                       Grid.Column="0"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                            <ContentControl Name="PART_SelectedItem"
                                            Grid.Column="0"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
                            <TextBox Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Theme="{StaticResource Forge.NumericUpDownTextBox}"
                                     Margin="{TemplateBinding Padding}"
                                     IsVisible="{TemplateBinding IsEditable}" />

                            <!-- 箭头区。宽度走上游 Component.arrowAreaWidth，与 NumericUpDown 的箭头区同宽。 -->
                            <Border Grid.Column="1"
                                    Width="{DynamicResource Forge.ComboBox.ArrowAreaWidth}"
                                    Background="Transparent">
                                <Path Name="PART_Chevron"
                                      Width="9" Height="5"
                                      Stretch="None"
                                      Data="M 0 0 L 4.5 5 L 9 0"
                                      Stroke="{DynamicResource Forge.Input.Border}"
                                      StrokeThickness="{DynamicResource Forge.Input.GlyphThickness}"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- MinWidth 跟随框宽：下拉至少与收起时一样宽，否则选项被挤成一条。
                                 ⚠ 若看到下拉跑到窗口左上角，先别怀疑 PlacementTarget ——
                                   **Popup 打开后不跟随窗口移动**，用脚本截图时若先开下拉再摆窗口就会这样，
                                   Semi 的下拉在同样条件下一样跑偏。见 StyleProbe 里那段注释。 -->
                            <Popup Name="PART_Popup"
                                   Grid.Column="0" Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{TemplateBinding}"
                                   Placement="BottomEdgeAlignedLeft"
                                   VerticalOffset="2"
                                   InheritsTransform="True"
                                   WindowManagerAddShadowHint="False"
                                   IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource Forge.Popup.Background}"
                                        BorderBrush="{DynamicResource Forge.Popup.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Forge.Popup.CornerRadius}"
                                        Padding="{DynamicResource Forge.Popup.Padding}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- ★ 悬停：1px 的边框本身变成**主题色**。★
             原先这条把 BorderBrush 设成 Forge.Input.Border —— 与常态**同值**，等于什么都没做
             （2026-08-26 查出来的死样式）。于是整个框只有箭头那 0.6px 的加粗在响应，
             实机上"鼠标移上去像没反应"。
             ⚠ **和聚焦态现在长得一样**（都是 1px 边框变主题色）——去掉聚焦那圈光晕之后，
               "指着"与"已经在编辑"就分不出来了。这是宿主明确要的取舍：宁可两态同形，
               也不要那圈看着像加粗的环。要分开的话，让悬停用一支更淡的主题色即可
               （Forge.Input.HoverBorder 与 FocusedBorder 本来就是两个键，改一个值的事）。
             ⚠ **只换颜色不换粗细**：Border 改 BorderThickness 会挤压内容区，鼠标移上去框里的
               文字会挪 1px，看着就是抖。要"变粗"只能在**外面**再叠一层（那一层占位，
               不参与内容布局，PART_FocusRing 就是那个位置）。
             ⚠ 这条排在 :focus-visible **之前**：同优先级下后写的赢，聚焦态本来就该压过悬停态。 -->
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.HoverBorder}" />
        </Style>

        <!-- ★ 聚焦：边框自己变主题色，**不点亮外面那圈环**。★
             上游 expUI 画的是「框外一圈 2px 的 focusColor 光晕 + 内边框转成与底同色」；
             本库去掉那圈光晕（宿主反馈：看着像边框加粗，而框里文字位置又没动，别扭），
             颜色改由内边框自己扛 —— Forge.Input.FocusedBorder 因此不再是"与底同色"，就是主题色。
             ⚠ PART_FocusRing 这个元素**保留**（它占 2px 布局），只是永远透明。删掉会让每个输入框
               外沿缩 2px，全应用的间距跟着变。 -->
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.FocusedBorder}" />
        </Style>

        <!-- ★ 箭头的常态与边框同粗同色（Forge.Input.Border）：它是**指示**不是内容，
             与正文同黑会压过框里的值本身（宿主实机反馈）。
             悬停时不铺底板，而是**箭头自己变粗变深** —— 底板那种反馈是给按钮的，
             而这个箭头整块框都可点，铺一块底反而像框里多了个按钮。 -->
        <Style Selector="^:pointerover /template/ Path#PART_Chevron">
            <Setter Property="StrokeThickness" Value="{DynamicResource Forge.Input.GlyphHoverThickness}" />
            <Setter Property="Stroke" Value="{DynamicResource Forge.Text.Secondary}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#PART_Chevron">
            <Setter Property="Stroke" Value="{DynamicResource Forge.Input.Disabled.Border}" />
        </Style>

        <!-- 下拉展开时箭头翻转，与「已展开」这个状态对应。 -->
        <Style Selector="^:dropdownopen /template/ Path#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ComboBox.Disabled.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Disabled.Border}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Button.Disabled.Foreground}" />
        </Style>

        <Style Selector="^[IsEditable=True] /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ComboBox.EditableBackground}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
