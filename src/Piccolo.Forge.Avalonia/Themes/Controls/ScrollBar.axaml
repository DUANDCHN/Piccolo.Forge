<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ScrollBar。形制取上游的 Transparent 那组（浮在内容上，轨道平时全透明、悬停才微微显现），
      不是 Opaque 组 —— 后者是给"滚动条占布局空间"的老式版面用的。

      ⚠ 但**滑块的填色与粗细是刻意偏离上游的**（2026-08-28）：上游那档浅色 #33737373＝20%
        不透明度，压在白底上算出来约 #E3E3E3，在密排数据的表格里实机看不见。现在常态抬到
        55%~65%、悬停再高一档，内缩由 3 收到 2（滑块 6px → 8px）。
        数值与理由写在两族 Controls.Colors.axaml 的档首注释、以及生成器
        scripts/gen-forge-palette.py 的 Own(...) 条目上；下限由 ScrollBarVisibilityTests 守。
        改这块**必须同时改生成器**，否则下次按上游重跑会把它静默冲掉。
      ⚠ 常态仍不画描边：试过给常态加 1px，描边色与填充色太近、4× 放大都看不出来，
        白添一个说不清作用的参数。描边只在悬停档出现（下面那两条样式），色仍取上游。

      ⚠ thumb 是**胶囊**。这里原先照 ScrollBarPainter 的 `int arc = 0` 画成直角，并注明
        "只有 isMac 分支才变胶囊" —— 那份参照是**旧版**的画法。新 UI（Rider 2024 起）
        两个平台都是圆头：常态一条细的、无边框；指针进到滚动条上才涨粗、加一圈描边。
        本主题按新 UI 走。CornerRadius 给的是"够大即可"的 6（= 厚度的一半），
        任何宽度下都被钳成半圆头，所以粗细一变不用跟着改半径。

      两档粗细都由 thumb 的**内缩**做（Padding → 模板内层 Border 的 Margin）：
      常态 ThumbMargin（细）、指针在滚动条上时 ThumbHoverMargin（粗）。
      判据挂在 **ScrollBar** 上而不是 thumb 上 —— 指针落在轨道上也该涨粗（上游如此）；
      描边与填色那两档才挂在 thumb 自己身上。

      ⚠ **内缩绝不能写成 thumb 自己的 Margin**（这里踩过）：Track 按
        `密度 = (轨道长 − 滑块长) ÷ 数值范围` 换算拖动，它眼里的"滑块长"是**布局**长度。
        写 Margin 会让布局长度比画出来的那条长 2×margin，于是拖一像素走的值比该走的多 ——
        实测 400 长的轨道、范围 900，拖满整条得到 915（多 1.7%），拖越远偏越多。
        写 Padding 则只是往里缩着画，布局长度不变，拖动严格 1:1（ScrollBarDragTests 盯着这条）。
    -->

    <ControlTheme x:Key="Forge.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Padding" Value="{DynamicResource Forge.ScrollBar.ThumbMargin}" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="Padding" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Margin="{TemplateBinding Padding}"
                        Background="{DynamicResource Forge.ScrollBar.Thumb}"
                        BorderBrush="{DynamicResource Forge.ScrollBar.ThumbBorder}"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource Forge.ScrollBar.ThumbRadius}" />
            </ControlTemplate>
        </Setter>
        <!-- 悬停/拖动都用 hover 档：上游只有两档（常态 / hovered），没有单独的按下色。
             描边也在这一档才出现（常态 BorderThickness=0）—— 细的那条上游是纯色块。 -->
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ScrollBar.ThumbHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.ScrollBar.ThumbHoverBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ScrollBar.ThumbHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.ScrollBar.ThumbHoverBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </ControlTheme>

    <!-- 翻页区（thumb 两侧）。上游没有可见的翻页按钮，这里只保留点击行为、不画东西。 -->
    <ControlTheme x:Key="Forge.ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Forge.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Forge.ScrollBar.Track}" />
        <Setter Property="MinWidth" Value="{DynamicResource Forge.ScrollBar.Thickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.ScrollBar.Thickness}" />

        <!-- 上游没有行进按钮（那对小箭头），整条就是轨道 + thumb。
             PART_LineUp/DownButton 仍要在模板里存在：ScrollBar 会去找它们，缺了会拿到 null。
             做成零尺寸不可见，而不是删掉。 -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Track_Root"
                        Background="{TemplateBinding Background}"
                        UseLayoutRounding="False">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton"
                                          Theme="{StaticResource Forge.ScrollBarPageButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton"
                                          Theme="{StaticResource Forge.ScrollBarPageButton}" />
                        </Track.IncreaseButton>
                        <Thumb Name="PART_Thumb"
                               Theme="{StaticResource Forge.ScrollBarThumb}" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- 轨道悬停时才微微显现（Transparent 组的 hoverTrackColor）。 -->
        <Style Selector="^:pointerover /template/ Border#PART_Track_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ScrollBar.TrackHover}" />
        </Style>

        <!-- 指针在滚动条上（**轨道也算**）→ thumb 涨粗。判据不能挂在 thumb 的 :pointerover 上：
             那样只有正好压在细条上才涨，从旁边挪过去够不着，与上游的手感不同。 -->
        <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Padding" Value="{DynamicResource Forge.ScrollBar.ThumbHoverMargin}" />
        </Style>
        <!-- 拖着往轨道外面甩时指针已不在滚动条上，:pointerover 会掉 —— 这条把粗细钉住，
             免得拖到一半自己缩回去。 -->
        <Style Selector="^ /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Padding" Value="{DynamicResource Forge.ScrollBar.ThumbHoverMargin}" />
        </Style>

        <!-- ⚠ 方向翻转**只对竖向**开：Track 的 IsDirectionReversed 表达的是"值 0 在哪一端"。
             竖向滚动条 0 在**顶端**（往下拖值变大）→ 要翻；横向 0 在**左端**（往右拖值变大）→ 不翻。
             一份模板两个方向共用，曾经把它写死成 True，于是横向滚动条拖起来整个是反的
             （2026-08-24 实机发现；ScrollBarDragTests 两个方向各有一条守着）。
             Avalonia 自带主题是竖横**两份模板**各写各的，所以那边没有这个问题。 -->
        <Style Selector="^:vertical /template/ Track#PART_Track">
            <Setter Property="IsDirectionReversed" Value="True" />
        </Style>

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource Forge.ScrollBar.Thickness}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource Forge.ScrollBar.Thickness}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
