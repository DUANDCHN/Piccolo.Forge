<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      TextBox。与 NumericUpDown / ComboBox 共用上游的 Component.* 那套边框与焦点规则。
      聚焦机制：外圈画 2px 的 Focus.Ring，同时内圈边框换成 Input.FocusedBorder（与底同色，
      让内边"消失"）—— 这是上游的做法，不是"聚焦时边框变蓝"。
    -->
    <ControlTheme x:Key="Forge.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Forge.Input.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Forge.Input.BorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Input.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource Forge.Input.Padding}" />
        <Setter Property="MinWidth" Value="{DynamicResource Forge.Input.MinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.Input.MinHeight}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Forge.Input.SelectionBackground}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Forge.Input.SelectionForeground}" />
        <!-- 光标取**正文色**，不是边框色：边框色在暗色档是 #40434A 这种深灰，
             落在同样深的输入框底上几乎看不见（实测 Islands 暗色下等于没有光标）。
             光标是"我在这儿打字"的指示，它该和字一样显眼 —— 各家（IntelliJ / VS Code / 系统）
             都是取正文色。
             ⚠ 粗细改不了：Avalonia 12 只暴露 CaretBrush（还有闪烁间隔），
               没有 CaretWidth 这类属性，光标恒为 1px，要变粗只能自绘 TextPresenter。 -->
        <Setter Property="CaretBrush" Value="{DynamicResource Forge.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="IBeam" />

        <Setter Property="Template">
            <ControlTemplate>
                    <!-- ⚠ 外环厚度 **0，不占布局**。原先是 Forge.Focus.RingThickness（2），
                         常态透明但始终占位 —— 于是控件上写 Height=30，看得见的框只有 26
                         （2026-08-26 实测：控件 30 / PART_Root 26 / 内容 24）。
                         聚焦现在画在 PART_Root 自己的边框上、不再点亮外环，这 2px 就成了纯占位，
                         留着只会让"设了高度却不是那个高度"。元素保留：模板部件名对外是契约。 -->
                <Border Name="PART_FocusRing"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource Forge.Focus.RingCornerRadius}">
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <!-- ⚠ 两个内嵌槽必须**自己居中**：它们停靠在 DockPanel 上，默认被拉满整条高度，
                                 里面的字就贴到顶（宿主实机 2026-08-26：保存路径框左边那个「保存根目录」
                                 比框里的路径高一截）。控件上的 VerticalContentAlignment 管的是正文那条
                                 ScrollViewer，管不到这两个槽。 -->
                            <!-- ⚠ 两个槽都要 **没内容就不占位**（IsVisible 而非光靠宽度 0）。
                                 停靠在 DockPanel 上的空槽宽为 0，但 Margin 照样吃掉 8px，于是
                                 一个什么前缀都没有的 TextBox / NumericUpDown，正文会比同行的 ComboBox
                                 右移 8px（实测 2026-08-28：ComboBox 字起点 x=10，NumericUpDown x=17）——
                                 宿主一排参数控件左边参差不齐就是这么来的。 -->
                            <!-- ★ 两个内嵌槽是**附加物**，不是正文：颜色压一档、与正文留出间距。★
                                 前缀标签（「保存根目录」这种）与正文同色又贴在一起时，读起来就是正文的一部分
                                 （宿主实机 2026-08-26）。压到 Forge.Text.Secondary 之后它退成"框的一部分"。
                                 ⚠ 只设在**槽**上，靠继承落到里面的字；宿主放控件进来时（框内小按钮）
                                   控件自己的主题会赢，不会被这一档染色。 -->
                            <ContentPresenter Name="PART_InnerLeftContent" DockPanel.Dock="Left"
                                              VerticalContentAlignment="Center"
                                              Foreground="{DynamicResource Forge.Text.Secondary}"
                                              Margin="{DynamicResource Forge.Input.AffixLeftMargin}"
                                              IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Content="{TemplateBinding InnerLeftContent}" />
                            <ContentPresenter Name="PART_InnerRightContent" DockPanel.Dock="Right"
                                              VerticalContentAlignment="Center"
                                              Foreground="{DynamicResource Forge.Text.Secondary}"
                                              Margin="{DynamicResource Forge.Input.AffixRightMargin}"
                                              IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Content="{TemplateBinding InnerRightContent}" />
                            <ScrollViewer Name="PART_ScrollViewer"
                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                          AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}">
                                <Panel>
                                    <TextBlock Name="PART_Watermark"
                                               Text="{TemplateBinding PlaceholderText}"
                                               Foreground="{DynamicResource Forge.Input.Placeholder}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                    <TextPresenter Name="PART_TextPresenter"
                                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                                   CaretIndex="{TemplateBinding CaretIndex}"
                                                   SelectionStart="{TemplateBinding SelectionStart}"
                                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="{TemplateBinding TextWrapping}"
                                                   LineHeight="{TemplateBinding LineHeight}"
                                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                                   PasswordChar="{TemplateBinding PasswordChar}"
                                                   RevealPassword="{TemplateBinding RevealPassword}"
                                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                   CaretBrush="{TemplateBinding CaretBrush}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Panel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- ★ 聚焦：边框自己变主题色，**不点亮外面那圈环**。★
             上游 expUI 画的是「框外一圈 2px 的 focusColor 光晕 + 内边框转成与底同色」；
             本库去掉那圈光晕（宿主反馈：看着像边框加粗，而框里文字位置又没动，别扭），
             颜色改由内边框自己扛 —— Forge.Input.FocusedBorder 因此不再是"与底同色"，就是主题色。
             ⚠ 外环（PART_FocusRing）已经**不占布局**了（厚度 0，见它自己那段说明），
               所以控件上写 Height=N，看得见的框就是 N。 -->
        <Style Selector="^:focus-within /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.FocusedBorder}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.Input.Disabled.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Disabled.Border}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Button.Disabled.Foreground}" />
        </Style>

        <!-- 校验失败：边框与焦点环都换成错误色（上游 Outline.error 走的是同一条画法）。 -->
        <Style Selector="^:error /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Error}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
