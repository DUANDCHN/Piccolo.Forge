<Styles x:Class="Piccolo.Forge.Avalonia.ColorPicker.ForgeColorPickerTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cp="using:Avalonia.Controls.Primitives">
    <!--  ColorPicker 一族的主题入口（附加包）。模板两档共用，故**不分档**，只有这一个入口。
          与主题包一起挂进 Application.Styles，且主题包在前：

            <themes:ForgeExpUiTheme />
            <colorpicker:ForgeColorPickerTheme />

          只挂本入口的话色板键找不到，控件画得出来但没颜色，且不报错。  -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Piccolo.Forge.Avalonia.ColorPicker/Themes/ColorPicker.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTheme x:Key="{x:Type ColorPicker}" TargetType="ColorPicker" BasedOn="{StaticResource Forge.ColorPicker}" />
            <ControlTheme x:Key="{x:Type ColorView}" TargetType="ColorView" BasedOn="{StaticResource Forge.ColorView}" />
            <ControlTheme x:Key="{x:Type cp:ColorSpectrum}" TargetType="cp:ColorSpectrum" BasedOn="{StaticResource Forge.ColorSpectrum}" />
            <ControlTheme x:Key="{x:Type cp:ColorSlider}" TargetType="cp:ColorSlider" BasedOn="{StaticResource Forge.ColorSlider}" />
            <ControlTheme x:Key="{x:Type cp:ColorPreviewer}" TargetType="cp:ColorPreviewer" BasedOn="{StaticResource Forge.ColorPreviewer}" />
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
