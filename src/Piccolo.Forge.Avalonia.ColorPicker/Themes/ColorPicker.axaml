<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cp="using:Avalonia.Controls.Primitives"
                    xmlns:cpconv="using:Avalonia.Controls.Primitives.Converters"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:local="using:Piccolo.Forge.Avalonia.ColorPicker">
    <!--
      取色器族。上游 IntelliJ 的 theme.json **没有**这一族的色板（它的取色器是 Swing 组件，
      不走主题系统），所以这里是按已有语汇组装：外框与触发按钮对齐 ComboBox，
      边框走 Forge.Input.Border / HoverBorder / FocusedBorder、弹出层走 Forge.Popup.*。
    -->

    <conv:ToBrushConverter x:Key="ForgeColorToBrush" />
    <conv:DoNothingForNullConverter x:Key="ForgeDoNothingForNull" />
    <cpconv:AccentColorConverter x:Key="ForgeAccentColor" />
    <local:ForgeDefaultColorPalette x:Key="ForgeDefaultPalette" />
    <local:ForgeRgbHexDisplayConverter x:Key="ForgeRgbHexDisplay" />
    <local:ForgeAlphaPercentConverter x:Key="ForgeAlphaPercent" />
    <local:ForgeColorModelEqualsConverter x:Key="ForgeColorModelEquals" />
    <local:ForgeComponentLabelConverter x:Key="ForgeComponentLabel" />

    <!-- 中性半透明棋盘格底纹：同一张画刷自动适配明/暗双主题，用于展示 Alpha 透明度。 -->
    <DrawingBrush x:Key="ForgeColorCheckerBrush"
                  TileMode="Tile"
                  Stretch="None"
                  DestinationRect="0,0,8,8">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#26808080" Geometry="M 0,0 H 4 V 4 H 0 Z" />
                <GeometryDrawing Brush="#26808080" Geometry="M 4,4 H 8 V 8 H 4 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 调色板的格子：选中靠一圈描边表示，不用通栏底色 —— 底色会把色块本身盖掉。 -->
    <ControlTheme x:Key="Forge.ColorPaletteItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ListBoxItem">
                <Border Name="PART_Root"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="{DynamicResource Forge.CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Border}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Focus.Ring}" />
        </Style>
    </ControlTheme>

    <!-- 分量页的 RGB / HSV 紧凑分段单选钮（不跨包 StaticResource，保持附加包解耦）。 -->
    <ControlTheme x:Key="Forge.ColorSegmentOption" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Secondary}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.CornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Primary}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource Forge.Popup.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Primary}" />
        </Style>
    </ControlTheme>

    <!-- 分量页的透明快捷档按钮（25% / 50% / 75% / 100%）。 -->
    <ControlTheme x:Key="Forge.ColorAlphaPresetButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Secondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.CornerRadius}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.HoverBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource Forge.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Forge.Overlay.Hover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource Forge.Overlay.Pressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <!-- 色谱：中间那块渐变由控件自己画，主题只管选择环与外框。 -->
    <ControlTheme x:Key="Forge.ColorSpectrum" TargetType="cp:ColorSpectrum">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Input.CornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="cp:ColorSpectrum">
                <Panel Name="PART_LayoutRoot">
                    <Panel Name="PART_SizingPanel">
                        <Border BorderBrush="{DynamicResource Forge.Input.Border}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <Panel>
                                <Rectangle Name="PART_SpectrumRectangle" />
                                <Rectangle Name="PART_SpectrumOverlayRectangle" />
                                <Ellipse Name="PART_SpectrumEllipse" />
                                <Ellipse Name="PART_SpectrumOverlayEllipse" />
                            </Panel>
                        </Border>
                        <Canvas Name="PART_InputTarget" Background="Transparent">
                            <!-- 选择环：底色任意，所以描双环（外深内浅），任何背景上都看得见。
                                 :light-selector / :dark-selector 由控件按当前色的明暗切换。 -->
                            <Panel Name="PART_SelectionEllipsePanel"
                                   Width="14" Height="14">
                                <Ellipse Name="SelectionOuter"
                                         Stroke="Black" StrokeThickness="3" Opacity="0.4" />
                                <Ellipse Name="SelectionInner"
                                         Stroke="White" StrokeThickness="1.5" />
                            </Panel>
                        </Canvas>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:light-selector /template/ Ellipse#SelectionInner">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="^:dark-selector /template/ Ellipse#SelectionInner">
            <Setter Property="Stroke" Value="Black" />
        </Style>
        <Style Selector="^:dark-selector /template/ Ellipse#SelectionOuter">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="^:large-selector /template/ Panel#PART_SelectionEllipsePanel">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
    </ControlTheme>

    <!-- 颜色滑条：轨道是控件画的渐变，主题只管 thumb、外框与 Alpha 棋盘格。
         thumb 与普通 Slider 同款（圆形描边），同时支持 Horizontal 与 Vertical 两条方向。 -->
    <ControlTheme x:Key="Forge.ColorSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="{DynamicResource Forge.Slider.ThumbSize}" />
        <Setter Property="Height" Value="{DynamicResource Forge.Slider.ThumbSize}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Panel>
                    <Ellipse Fill="Transparent" Stroke="Black" StrokeThickness="3" Opacity="0.35" />
                    <Ellipse Fill="Transparent" Stroke="White" StrokeThickness="1.5" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Forge.ColorSlider" TargetType="cp:ColorSlider">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Input.CornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="cp:ColorSlider">
                <Panel>
                    <Border Name="PART_Root"
                            BorderBrush="{DynamicResource Forge.Input.Border}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <!-- 仅 Alpha 分量露出棋盘格底衬，其它通道不显示透明底纹。 -->
                            <Border Name="PART_Checker"
                                    Background="{StaticResource ForgeColorCheckerBrush}"
                                    IsVisible="False" />
                            <Border Background="{TemplateBinding Background}" />
                        </Panel>
                    </Border>
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseButton>
                            <Button Name="PART_DecreaseButton"
                                    Theme="{DynamicResource Forge.ColorSliderTrackButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <Button Name="PART_IncreaseButton"
                                    Theme="{DynamicResource Forge.ColorSliderTrackButton}" />
                        </Track.IncreaseButton>
                        <Thumb Theme="{DynamicResource Forge.ColorSliderThumb}" />
                    </Track>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[ColorComponent=Alpha] /template/ Border#PART_Checker">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Width" Value="18" />
        </Style>
    </ControlTheme>

    <!-- 轨道两侧的按钮：完全透明，只负责点击跳转，渐变由 ColorSlider 自己画在 Background 上。 -->
    <ControlTheme x:Key="Forge.ColorSliderTrackButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- 预览条：中间是当前色，两侧各两格深浅变体（通过 AccentColorConverter 绑定），
         当 IsAccentColorsVisible=False 时当前色跨满 5 列，彻底消除左右空白。 -->
    <ControlTheme x:Key="Forge.ColorPreviewer" TargetType="cp:ColorPreviewer">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <ControlTemplate TargetType="cp:ColorPreviewer">
                <Border BorderBrush="{DynamicResource Forge.Input.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Forge.Input.CornerRadius}"
                        Background="{StaticResource ForgeColorCheckerBrush}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <Border Name="PART_AccentDecrement2Border"
                                Grid.Column="0"
                                Cursor="Hand"
                                IsVisible="{TemplateBinding IsAccentColorsVisible}"
                                Background="{Binding HsvColor,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource ForgeAccentColor},
                                            ConverterParameter=-2}" />
                        <Border Name="PART_AccentDecrement1Border"
                                Grid.Column="1"
                                Cursor="Hand"
                                IsVisible="{TemplateBinding IsAccentColorsVisible}"
                                Background="{Binding HsvColor,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource ForgeAccentColor},
                                            ConverterParameter=-1}" />
                        <!-- 中间那格是当前色。 -->
                        <Border Name="PART_CurrentColorBorder"
                                Grid.Column="2"
                                Background="{Binding HsvColor,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource ForgeColorToBrush}}" />
                        <Border Name="PART_AccentIncrement1Border"
                                Grid.Column="3"
                                Cursor="Hand"
                                IsVisible="{TemplateBinding IsAccentColorsVisible}"
                                Background="{Binding HsvColor,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource ForgeAccentColor},
                                            ConverterParameter=1}" />
                        <Border Name="PART_AccentIncrement2Border"
                                Grid.Column="4"
                                Cursor="Hand"
                                IsVisible="{TemplateBinding IsAccentColorsVisible}"
                                Background="{Binding HsvColor,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource ForgeAccentColor},
                                            ConverterParameter=2}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsAccentColorsVisible=False] /template/ Border#PART_CurrentColorBorder">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="5" />
        </Style>
    </ControlTheme>

    <!--
      ColorView —— 取色面板（色谱 + 调色板 + 分量三页签 + 预览条 + 带 # 前缀 Hex 输入）。
    -->
    <ControlTheme x:Key="Forge.ColorView" TargetType="ColorView">
        <Setter Property="MinWidth" Value="256" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Palette" Value="{StaticResource ForgeDefaultPalette}" />
        <Setter Property="PaletteColumnCount" Value="8" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ColorView">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="10">
                        <TabControl Name="PART_TabControl"
                                    Theme="{DynamicResource Forge.TabControl}"
                                    SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <TabControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </TabControl.ItemsPanel>
                            <TabControl.Styles>
                                <Style Selector="TabItem">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </TabControl.Styles>

                            <!-- 页一：色谱（2D 光谱画布 + 右侧双竖滑条：第三分量 & Alpha）。 -->
                            <TabItem Header="色谱" IsVisible="{TemplateBinding IsColorSpectrumVisible}">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8"
                                      Height="184"
                                      Margin="0,10,0,0">
                                    <cp:ColorSpectrum Name="PART_ColorSpectrum"
                                                      Grid.Column="0"
                                                      Theme="{DynamicResource Forge.ColorSpectrum}"
                                                      Components="{TemplateBinding ColorSpectrumComponents}"
                                                      Shape="{TemplateBinding ColorSpectrumShape}"
                                                      HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      MinHue="{TemplateBinding MinHue}"
                                                      MaxHue="{TemplateBinding MaxHue}"
                                                      MinSaturation="{TemplateBinding MinSaturation}"
                                                      MaxSaturation="{TemplateBinding MaxSaturation}"
                                                      MinValue="{TemplateBinding MinValue}"
                                                      MaxValue="{TemplateBinding MaxValue}"
                                                      Height="184" />
                                    <cp:ColorSlider Name="SpectrumThirdComponentSlider"
                                                    Grid.Column="1"
                                                    Theme="{DynamicResource Forge.ColorSlider}"
                                                    Orientation="Vertical"
                                                    ColorComponent="Component3"
                                                    ColorModel="Hsva"
                                                    IsVisible="{TemplateBinding IsColorSpectrumSliderVisible}"
                                                    HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <cp:ColorSlider Name="SpectrumAlphaSlider"
                                                    Grid.Column="2"
                                                    Theme="{DynamicResource Forge.ColorSlider}"
                                                    Orientation="Vertical"
                                                    ColorComponent="Alpha"
                                                    ColorModel="Hsva"
                                                    IsVisible="{TemplateBinding IsAlphaVisible}"
                                                    IsEnabled="{TemplateBinding IsAlphaEnabled}"
                                                    HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </Grid>
                            </TabItem>

                            <!-- 页二：调色板（内置默认 8×5 标准+灰阶+半透常用色板，支持 Palette 覆盖）。 -->
                            <TabItem Header="调色板" IsVisible="{TemplateBinding IsColorPaletteVisible}">
                                <ListBox Name="PART_PaletteListBox"
                                         ItemContainerTheme="{DynamicResource Forge.ColorPaletteItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ItemsSource="{TemplateBinding PaletteColors}"
                                         SelectedItem="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource ForgeDoNothingForNull}}"
                                         Margin="0,10,0,0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding PaletteColumnCount, RelativeSource={RelativeSource AncestorType=ColorView}}" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="24" Height="24"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource ForgeColorCheckerBrush}"
                                                    BorderBrush="{DynamicResource Forge.Input.Border}"
                                                    BorderThickness="1">
                                                <Border Background="{Binding Converter={StaticResource ForgeColorToBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <!-- 页三：分量（顶部 RGB / HSV 模型切换 + 通道字母标签 + 棋盘格 Alpha 滑条 + 透明快捷档）。 -->
                            <TabItem Header="分量" IsVisible="{TemplateBinding IsColorComponentsVisible}">
                                <StackPanel Spacing="8" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{TemplateBinding IsColorModelVisible}">
                                        <TextBlock Grid.Column="0"
                                                   Text="颜色模型"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Forge.Text.Secondary}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                CornerRadius="{DynamicResource Forge.CornerRadius}"
                                                Background="{DynamicResource Forge.Tab.HoverBackground}"
                                                Padding="2">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Name="RgbModelRadio"
                                                             Theme="{StaticResource Forge.ColorSegmentOption}"
                                                             Content="RGB"
                                                             IsChecked="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ForgeColorModelEquals}, ConverterParameter=Rgba, Mode=TwoWay}" />
                                                <RadioButton Name="HsvModelRadio"
                                                             Theme="{StaticResource Forge.ColorSegmentOption}"
                                                             Content="HSV"
                                                             IsChecked="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ForgeColorModelEquals}, ConverterParameter=Hsva, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8"
                                          IsVisible="{TemplateBinding IsComponentSliderVisible}">
                                        <TextBlock x:Name="Comp1Label"
                                                   Grid.Column="0"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Forge.Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ForgeComponentLabel}, ConverterParameter=1}" />
                                        <cp:ColorSlider x:Name="Comp1Slider"
                                                        Grid.Column="1"
                                                        Theme="{DynamicResource Forge.ColorSlider}"
                                                        ColorComponent="Component1"
                                                        ColorModel="{TemplateBinding ColorModel}"
                                                        VerticalAlignment="Center"
                                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <NumericUpDown Grid.Column="2"
                                                       Theme="{DynamicResource Forge.NumericUpDown}"
                                                       Width="64"
                                                       ShowButtonSpinner="False"
                                                       FormatString="0"
                                                       Minimum="{Binding #Comp1Slider.Minimum}"
                                                       Maximum="{Binding #Comp1Slider.Maximum}"
                                                       Value="{Binding #Comp1Slider.Value, Mode=TwoWay}"
                                                       IsVisible="{TemplateBinding IsComponentTextInputVisible}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8"
                                          IsVisible="{TemplateBinding IsComponentSliderVisible}">
                                        <TextBlock x:Name="Comp2Label"
                                                   Grid.Column="0"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Forge.Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ForgeComponentLabel}, ConverterParameter=2}" />
                                        <cp:ColorSlider x:Name="Comp2Slider"
                                                        Grid.Column="1"
                                                        Theme="{DynamicResource Forge.ColorSlider}"
                                                        ColorComponent="Component2"
                                                        ColorModel="{TemplateBinding ColorModel}"
                                                        VerticalAlignment="Center"
                                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <NumericUpDown Grid.Column="2"
                                                       Theme="{DynamicResource Forge.NumericUpDown}"
                                                       Width="64"
                                                       ShowButtonSpinner="False"
                                                       FormatString="0"
                                                       Minimum="{Binding #Comp2Slider.Minimum}"
                                                       Maximum="{Binding #Comp2Slider.Maximum}"
                                                       Value="{Binding #Comp2Slider.Value, Mode=TwoWay}"
                                                       IsVisible="{TemplateBinding IsComponentTextInputVisible}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8"
                                          IsVisible="{TemplateBinding IsComponentSliderVisible}">
                                        <TextBlock x:Name="Comp3Label"
                                                   Grid.Column="0"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Forge.Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding ColorModel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ForgeComponentLabel}, ConverterParameter=3}" />
                                        <cp:ColorSlider x:Name="Comp3Slider"
                                                        Grid.Column="1"
                                                        Theme="{DynamicResource Forge.ColorSlider}"
                                                        ColorComponent="Component3"
                                                        ColorModel="{TemplateBinding ColorModel}"
                                                        VerticalAlignment="Center"
                                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <NumericUpDown Grid.Column="2"
                                                       Theme="{DynamicResource Forge.NumericUpDown}"
                                                       Width="64"
                                                       ShowButtonSpinner="False"
                                                       FormatString="0"
                                                       Minimum="{Binding #Comp3Slider.Minimum}"
                                                       Maximum="{Binding #Comp3Slider.Maximum}"
                                                       Value="{Binding #Comp3Slider.Value, Mode=TwoWay}"
                                                       IsVisible="{TemplateBinding IsComponentTextInputVisible}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8"
                                          IsVisible="{TemplateBinding IsAlphaVisible}"
                                          IsEnabled="{TemplateBinding IsAlphaEnabled}">
                                        <TextBlock x:Name="AlphaLabel"
                                                   Grid.Column="0"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Forge.Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="A" />
                                        <cp:ColorSlider x:Name="AlphaSlider"
                                                        Grid.Column="1"
                                                        Theme="{DynamicResource Forge.ColorSlider}"
                                                        ColorComponent="Alpha"
                                                        ColorModel="{TemplateBinding ColorModel}"
                                                        VerticalAlignment="Center"
                                                        HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <NumericUpDown Grid.Column="2"
                                                       Theme="{DynamicResource Forge.NumericUpDown}"
                                                       Width="64"
                                                       ShowButtonSpinner="False"
                                                       FormatString="0"
                                                       Minimum="{Binding #AlphaSlider.Minimum}"
                                                       Maximum="{Binding #AlphaSlider.Maximum}"
                                                       Value="{Binding #AlphaSlider.Value, Mode=TwoWay}"
                                                       IsVisible="{TemplateBinding IsComponentTextInputVisible}" />
                                    </Grid>

                                    <!-- 透明度快捷百分比预设（适应视觉过曝/遮罩等半透明场景）。 -->
                                    <UniformGrid Rows="1" Columns="4"
                                                 IsVisible="{TemplateBinding IsAlphaVisible}"
                                                 IsEnabled="{TemplateBinding IsAlphaEnabled}">
                                        <Button Theme="{StaticResource Forge.ColorAlphaPresetButton}"
                                                Margin="0,0,2,0" Content="25%" local:ForgeAlphaQuickPreset.Percent="25" />
                                        <Button Theme="{StaticResource Forge.ColorAlphaPresetButton}"
                                                Margin="2,0" Content="50%" local:ForgeAlphaQuickPreset.Percent="50" />
                                        <Button Theme="{StaticResource Forge.ColorAlphaPresetButton}"
                                                Margin="2,0" Content="75%" local:ForgeAlphaQuickPreset.Percent="75" />
                                        <Button Theme="{StaticResource Forge.ColorAlphaPresetButton}"
                                                Margin="2,0,0,0" Content="100%" local:ForgeAlphaQuickPreset.Percent="100" />
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <cp:ColorPreviewer Theme="{DynamicResource Forge.ColorPreviewer}"
                                           HsvColor="{Binding HsvColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                           IsAccentColorsVisible="{TemplateBinding IsAccentColorsVisible}"
                                           IsVisible="{TemplateBinding IsColorPreviewVisible}" />

                        <TextBox Name="PART_HexTextBox"
                                 Theme="{DynamicResource Forge.TextBox}"
                                 InnerLeftContent="#"
                                 IsVisible="{TemplateBinding IsHexInputVisible}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
      ColorPicker —— 方案 A：输入框对齐型触发器（棋盘格色块 + Hex 文本 + 透明度% + 下拉箭头）。
      与同列的 ComboBox / NumericUpDown 等高等圆角，悬停与展开边框Feedback同口径。
    -->
    <ControlTheme x:Key="Forge.ColorPicker" TargetType="ColorPicker">
        <Setter Property="Background" Value="{DynamicResource Forge.ComboBox.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Forge.Input.BorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Forge.Input.CornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource Forge.Input.MinHeight}" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Palette" Value="{StaticResource ForgeDefaultPalette}" />
        <Setter Property="PaletteColumnCount" Value="8" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ColorPicker">
                <Panel>
                    <ToggleButton Name="PART_ToggleButton"
                                  Theme="{DynamicResource Forge.ColorPickerButton}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  MinHeight="{TemplateBinding MinHeight}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    Width="26" Height="16"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    Background="{StaticResource ForgeColorCheckerBrush}"
                                    BorderBrush="{DynamicResource Forge.Input.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border Name="PART_CurrentColor"
                                        Background="{Binding Color,
                                                    RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource ForgeColorToBrush}}" />
                            </Border>

                            <TextBlock Name="PART_HexDisplayText"
                                       Grid.Column="1"
                                       Margin="8,0,4,0"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Color,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Converter={StaticResource ForgeRgbHexDisplay}}" />

                            <Border Name="PART_AlphaBadge"
                                    Grid.Column="2"
                                    Margin="0,0,2,0"
                                    Padding="5,1"
                                    CornerRadius="3"
                                    Background="{DynamicResource Forge.Tab.HoverBackground}"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding IsAlphaVisible}">
                                <TextBlock FontSize="10.5"
                                           Foreground="{DynamicResource Forge.Text.Secondary}"
                                           Text="{Binding Color,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Converter={StaticResource ForgeAlphaPercent}}" />
                            </Border>
                        </Grid>
                    </ToggleButton>

                    <!-- ⚠ ColorPicker **没有**弹出相关的属性（IsDropDownOpen 之类都不存在），
                         开合完全由模板自己管：Popup 直接绑那颗 ToggleButton 的 IsChecked。 -->
                    <Popup Name="PART_Popup"
                           IsOpen="{Binding #PART_ToggleButton.IsChecked, Mode=TwoWay}"
                           PlacementTarget="{TemplateBinding}"
                           Placement="BottomEdgeAlignedLeft"
                           VerticalOffset="2"
                           InheritsTransform="True"
                           WindowManagerAddShadowHint="False"
                           IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource Forge.Popup.Background}"
                                BorderBrush="{DynamicResource Forge.Popup.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Forge.Popup.CornerRadius}"
                                Padding="12">
                            <StackPanel Spacing="10" Width="256">
                                <!-- ⚠ 弹出层里**内嵌一个 ColorView**，把全部显示与调色板属性透传进去；
                                     Color 双向绑回宿主。内嵌的 Hex 框关掉，下方复用 ColorPicker 必需部件 PART_HexTextBox。 -->
                                <ColorView Theme="{DynamicResource Forge.ColorView}"
                                           Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                           ColorModel="{TemplateBinding ColorModel}"
                                           ColorSpectrumShape="{TemplateBinding ColorSpectrumShape}"
                                           ColorSpectrumComponents="{TemplateBinding ColorSpectrumComponents}"
                                           HexInputAlphaPosition="{TemplateBinding HexInputAlphaPosition}"
                                           IsAlphaVisible="{TemplateBinding IsAlphaVisible}"
                                           IsAlphaEnabled="{TemplateBinding IsAlphaEnabled}"
                                           IsColorModelVisible="{TemplateBinding IsColorModelVisible}"
                                           IsColorSpectrumVisible="{TemplateBinding IsColorSpectrumVisible}"
                                           IsColorPaletteVisible="{TemplateBinding IsColorPaletteVisible}"
                                           IsColorComponentsVisible="{TemplateBinding IsColorComponentsVisible}"
                                           IsColorPreviewVisible="{TemplateBinding IsColorPreviewVisible}"
                                           IsAccentColorsVisible="{TemplateBinding IsAccentColorsVisible}"
                                           IsColorSpectrumSliderVisible="{TemplateBinding IsColorSpectrumSliderVisible}"
                                           IsComponentSliderVisible="{TemplateBinding IsComponentSliderVisible}"
                                           IsComponentTextInputVisible="{TemplateBinding IsComponentTextInputVisible}"
                                           PaletteColumnCount="{TemplateBinding PaletteColumnCount}"
                                           Palette="{TemplateBinding Palette}"
                                           IsHexInputVisible="False"
                                           BorderThickness="0"
                                           Padding="0" />

                                <TextBox Name="PART_HexTextBox"
                                         Theme="{DynamicResource Forge.TextBox}"
                                         InnerLeftContent="#"
                                         IsVisible="{TemplateBinding IsHexInputVisible}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- 取色按钮：外观与悬停/展开反馈对齐 ComboBox，表单域语义保持 Arrow 指针。 -->
    <ControlTheme x:Key="Forge.ColorPickerButton" TargetType="ToggleButton">
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <Border Name="PART_Overlay" Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border Grid.Column="1"
                                    Width="{DynamicResource Forge.ComboBox.ArrowAreaWidth}"
                                    Background="Transparent">
                                <Path Name="PART_Chevron"
                                      Width="9" Height="5"
                                      Stretch="None"
                                      Data="M 0 0 L 4.5 5 L 9 0"
                                      Stroke="{DynamicResource Forge.Input.Border}"
                                      StrokeThickness="{DynamicResource Forge.Input.GlyphThickness}"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      RenderTransformOrigin="50%,50%"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.HoverBorder}" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#PART_Chevron">
            <Setter Property="StrokeThickness" Value="{DynamicResource Forge.Input.GlyphHoverThickness}" />
            <Setter Property="Stroke" Value="{DynamicResource Forge.Text.Secondary}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.FocusedBorder}" />
        </Style>
        <Style Selector="^:checked /template/ Path#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Forge.ComboBox.Disabled.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Forge.Input.Disabled.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#PART_Chevron">
            <Setter Property="Stroke" Value="{DynamicResource Forge.Input.Disabled.Border}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Button.Disabled.Foreground}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
