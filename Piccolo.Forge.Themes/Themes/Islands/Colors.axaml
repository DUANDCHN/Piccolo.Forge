<!--  ★ Islands 主题的全部颜色。★  REQ-068 从 ForgeColors.axaml 拆出。

      这份只属于** Islands 一族**：只被 Themes/Islands/Theme.axaml 引，
      经典那套在 Themes/ExpUi/Colors.axaml，两边各改各的、不共用文件。

      ⚠ **这个文件是从 ForgePalette 转写出来的，别手改数值。**
        转写有一处会静默出错：上游 / ForgeColor.Parse 是 #RRGGBBAA（alpha 在后），
        而 Avalonia 的 Color 是 #AARRGGBB（alpha 在前）——**顺序相反**。
        原样抄会把 #0000001D（黑 11%）读成 alpha=0，那个状态的颜色整个消失且不报错。
        每个 8 位的值后面都注了上游原文；真正的守护是 ForgeThemeDictionaryTests，
        它逐键断言这里的值 == ForgePalette 对应字段（并做过反证：注入字节序错误当场红）。

      族（expUI / Islands）仍然进**键名**，明暗进 **ThemeDictionaries**：
      键名前缀是宿主按族覆盖的抬头（REQ-068 “不做”边界里写死了不改）。
      宿主要覆盖，就在自己的 ThemeDictionaries 里重定义同名键。  -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--  按钮 / 条带  -->
            <Color x:Key="Forge.Islands.ButtonForeground">#5F6269</Color>
            <Color x:Key="Forge.Islands.ButtonSelectedForeground">#FFFFFF</Color>
            <Color x:Key="Forge.Islands.ButtonSelectedBackground">#3871E1</Color>
            <Color x:Key="Forge.Islands.ButtonPressedBackground">#1D000000</Color>  <!-- 上游 #0000001D -->
            <Color x:Key="Forge.Islands.ButtonHoverBackground">#12000000</Color>  <!-- 上游 #00000012 -->
            <Color x:Key="Forge.Islands.StripeSeparator">#20000000</Color>  <!-- 上游 #00000020 -->
            <Color x:Key="Forge.Islands.StripeSeparatorDragAndDrop">#3871E1</Color>
            <Color x:Key="Forge.Islands.StripeBadge">#E55765</Color>  <!-- 角标：expUI 的错误红（Notification.errorForeground 那一档） -->
            <Color x:Key="Forge.Islands.StripeBackground">#E9EAEE</Color>
            <Color x:Key="Forge.Islands.StripeBorder">#00000000</Color>  <!-- 上游 #00000000 -->

            <!--  拖拽反馈  -->
            <Color x:Key="Forge.Islands.ButtonDropBackground">#803671E5</Color>  <!-- 上游 #3671E580 -->
            <Color x:Key="Forge.Islands.ButtonDropBorder">#3871E1</Color>
            <Color x:Key="Forge.Islands.DragAreaBackground">#4D366ACF</Color>  <!-- 上游 #366ACF4D -->

            <!--  面板标题条  -->
            <Color x:Key="Forge.Islands.Foreground">#000000</Color>
            <Color x:Key="Forge.Islands.HeaderBackground">#FFFFFF</Color>
            <Color x:Key="Forge.Islands.HeaderBorder">#E9EAEE</Color>
            <Color x:Key="Forge.Islands.HeaderTabHoverBackground">#12000000</Color>  <!-- 上游 #00000012 -->
            <Color x:Key="Forge.Islands.HeaderTabUnderline">#3871E1</Color>
            <Color x:Key="Forge.Islands.HeaderTabInactiveUnderline">#D1D3D9</Color>

            <!--  岛（Islands 那层外框；expUI 不参与绘制）  -->
            <Color x:Key="Forge.Islands.IslandBorder">#FFFFFF</Color>

            <!--  同一条边上两块面板之间那条 1px 线（ForgeControl.DockDividerBrush 取它）。
                  值 = ForgePalette.IslandsLight.WindowBorder（上游 transparent）；归成资源键是为了让宿主能覆盖，见那个属性的说明。  -->
            <Color x:Key="Forge.Islands.WindowBorder">#00000000</Color>

            <!--  编辑区  -->
            <Color x:Key="Forge.Islands.EditorBackground">#FFFFFF</Color>  <!-- editor-bg -->
            <Color x:Key="Forge.Islands.EditorTabsBorder">#E9EAEE</Color>
            <Color x:Key="Forge.Islands.EditorTabHoverBackground">#12000000</Color>  <!-- 上游 #00000012 -->
            <Color x:Key="Forge.Islands.EditorTabSelectedBackground">#E3EBFE</Color>
            <Color x:Key="Forge.Islands.EditorTabSelectedBorder">#A7C5FF</Color>
            <Color x:Key="Forge.Islands.EditorTabInactiveSelectedBackground">#E9EAEE</Color>
            <Color x:Key="Forge.Islands.EditorTabInactiveSelectedBorder">#D1D3D9</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!--  按钮 / 条带  -->
            <Color x:Key="Forge.Islands.ButtonForeground">#9FA2A8</Color>
            <Color x:Key="Forge.Islands.ButtonSelectedForeground">#FFFFFF</Color>
            <Color x:Key="Forge.Islands.ButtonSelectedBackground">#3871E1</Color>
            <Color x:Key="Forge.Islands.ButtonPressedBackground">#26FFFFFF</Color>  <!-- 上游 #FFFFFF26 -->
            <Color x:Key="Forge.Islands.ButtonHoverBackground">#16FFFFFF</Color>  <!-- 上游 #FFFFFF16 -->
            <Color x:Key="Forge.Islands.StripeSeparator">#21FFFFFF</Color>  <!-- 上游 #FFFFFF21 -->
            <Color x:Key="Forge.Islands.StripeSeparatorDragAndDrop">#3871E1</Color>
            <Color x:Key="Forge.Islands.StripeBadge">#E55765</Color>
            <Color x:Key="Forge.Islands.StripeBackground">#26282C</Color>
            <Color x:Key="Forge.Islands.StripeBorder">#00000000</Color>  <!-- 上游 #00000000 -->

            <!--  拖拽反馈  -->
            <Color x:Key="Forge.Islands.ButtonDropBackground">#803671E5</Color>  <!-- 上游 #3671E580 -->
            <Color x:Key="Forge.Islands.ButtonDropBorder">#3871E1</Color>
            <Color x:Key="Forge.Islands.DragAreaBackground">#4D366ACF</Color>  <!-- 上游 #366ACF4D -->

            <!--  面板标题条  -->
            <Color x:Key="Forge.Islands.Foreground">#D1D3D9</Color>
            <Color x:Key="Forge.Islands.HeaderBackground">#191A1C</Color>
            <Color x:Key="Forge.Islands.HeaderBorder">#26282C</Color>
            <Color x:Key="Forge.Islands.HeaderTabHoverBackground">#17FFFFFF</Color>  <!-- 上游 #FFFFFF17 -->
            <Color x:Key="Forge.Islands.HeaderTabUnderline">#3871E1</Color>
            <Color x:Key="Forge.Islands.HeaderTabInactiveUnderline">#5A5D63</Color>

            <!--  岛（Islands 那层外框；expUI 不参与绘制）  -->
            <Color x:Key="Forge.Islands.IslandBorder">#191A1C</Color>

            <!--  同一条边上两块面板之间那条 1px 线（ForgeControl.DockDividerBrush 取它）。
                  值 = ForgePalette.IslandsDark.WindowBorder（上游 transparent）；归成资源键是为了让宿主能覆盖，见那个属性的说明。  -->
            <Color x:Key="Forge.Islands.WindowBorder">#00000000</Color>

            <!--  编辑区  -->
            <Color x:Key="Forge.Islands.EditorBackground">#191A1C</Color>  <!-- editor-bg -->
            <Color x:Key="Forge.Islands.EditorTabsBorder">#26282C</Color>
            <Color x:Key="Forge.Islands.EditorTabHoverBackground">#17FFFFFF</Color>  <!-- 上游 #FFFFFF17 -->
            <Color x:Key="Forge.Islands.EditorTabSelectedBackground">#233558</Color>
            <Color x:Key="Forge.Islands.EditorTabSelectedBorder">#2E4D89</Color>
            <Color x:Key="Forge.Islands.EditorTabInactiveSelectedBackground">#26282C</Color>
            <Color x:Key="Forge.Islands.EditorTabInactiveSelectedBorder">#40434A</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
