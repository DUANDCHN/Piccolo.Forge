<Project>

  <PropertyGroup>
    <!-- 库多目标；tests / samples 各自覆盖成单目标 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 复刻工程，出处比手速重要：警告一律当错误处理 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
  </PropertyGroup>

  <!-- NuGet 包元数据（src/ 下的库共用；tests / samples 设 IsPackable=false） -->
  <PropertyGroup>
    <!-- 主版本跟随 Avalonia 主版本（12），与 Semi.Avalonia 等包同一惯例 -->
    <VersionPrefix>12.1.0.6</VersionPrefix>
    <Authors>DUANDCHN</Authors>
    <Copyright>Copyright (c) DUANDCHN</Copyright>
    <!-- 尚未开源：随包附自定义许可证文件，不用 SPDX 表达式 -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/DUANDCHN/Piccolo.Forge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DUANDCHN/Piccolo.Forge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;docking;tool-window;ide;intellij;expui;islands</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 源码可调试：SourceLink（.NET 8 SDK 内置）+ 符号包 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- 公开 API 有账本：改了 PublicAPI.*.txt 之外的公开面，RS0016/RS0017 当场报错。
       RS0026/RS0027（可选参数的多重载）是 Roslyn 团队自己的约定，本库用可选参数做渐进式重载，关掉。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
