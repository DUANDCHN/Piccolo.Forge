<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Piccolo.Forge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 不是对外 API，不强制 XML 注释 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- 测试用了 [ObservableProperty] 的 partial 属性语法（CT 8.4 才有）。
         库的地板是 8.2.2；测试不随包发布，钉高不影响 nuspec，运行期向上二进制兼容。
         （没有这行时 CT 经 Mvvm.CommunityToolkit 的 ProjectReference 传递而来，版本跟地板走。） -->
    <PackageReference Include="CommunityToolkit.Mvvm" VersionOverride="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Piccolo.Forge.Model/Piccolo.Forge.Model.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Mvvm/Piccolo.Forge.Mvvm.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Mvvm.CommunityToolkit/Piccolo.Forge.Mvvm.CommunityToolkit.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Avalonia/Piccolo.Forge.Avalonia.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.ExpUi/Piccolo.Forge.Themes.ExpUi.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.Islands/Piccolo.Forge.Themes.Islands.csproj" />
  </ItemGroup>

</Project>
