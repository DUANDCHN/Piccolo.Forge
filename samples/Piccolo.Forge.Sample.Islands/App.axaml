<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forge="using:Piccolo.Forge.Avalonia"
             x:Class="Piccolo.Forge.Sample.Islands.App"
             RequestedThemeVariant="Dark">
    <!--  ★ 宿主要做的全部事情就是这一行。★
          ForgeTheme 是**完整基础主题**（色板 + 外壳 + 控件），族由 Family 属性定 ——
          本工程只引了 Themes.Islands 一个资源包，Family 也就只能选 Islands（选别的启动即抛，
          异常里写明缺哪个包）。⚠ 不要再叠 FluentTheme：两套基础主题抢同一批隐式
          ControlTheme，谁赢取决于先后，且不报错。  -->
    <Application.Styles>
        <forge:ForgeTheme Family="Islands" />
    </Application.Styles>
</Application>
