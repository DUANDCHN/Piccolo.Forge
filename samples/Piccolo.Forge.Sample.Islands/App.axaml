<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Piccolo.Forge.Themes.Islands"
             x:Class="Piccolo.Forge.Sample.Islands.App"
             RequestedThemeVariant="Dark">
    <!--  ★ 宿主要做的全部事情就是这一行。★
          ForgeIslandsTheme 是**完整基础主题**：色板 + 外壳 + 控件。
          ⚠ 这里**不再叠 FluentTheme** —— 12.1.0 之前外壳库不管控件，示例得找别人要基础主题；
            现在一行装完。叠第二套会抢同一批隐式 ControlTheme，谁赢取决于先后，且不报错。  -->
    <Application.Styles>
        <themes:ForgeIslandsTheme />
    </Application.Styles>
</Application>
