<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:forge="using:Piccolo.Forge.Avalonia"
        xmlns:vm="using:Piccolo.Forge.Sample.Mvvm.ViewModels"
        x:Class="Piccolo.Forge.Sample.Mvvm.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Piccolo.Forge —— MVVM 接法"
        Width="1000" Height="640">
    <!--  外框写在 XAML 里；Shell / Editor 与它的对接（Attach）是命令式 API，
          在 code-behind 里做 —— 那几行是全应用仅有的"控件代码"，只出现一次。  -->
    <forge:ForgeControl x:Name="Frame" />
</Window>
