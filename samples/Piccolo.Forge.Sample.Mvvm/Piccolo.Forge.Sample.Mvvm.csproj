<Project Sdk="Microsoft.NET.Sdk">

  <!--  ★ MVVM 接法的演示（结构照 Dock 的 MvvmSample：ViewModels/ 与 Views/ 分目录、
        视图由 ViewLocator 按命名约定解析）。★

        与外壳示例（Sample.ExpUi / .Islands）的分工：那两个演示**外壳长什么样**，
        视图解析刻意从简（直接塞控件）；本示例演示**宿主该怎么组织代码** ——
        面板类只有状态与命令，一行控件代码都没有。

        CommunityToolkit.Mvvm 这里**直接引用**。技术上可以省 —— CT 带 buildTransitive，
        源生成器会随传递引用流动（一般 analyzer 不会，CT 特意做了）；但直接引让"这个工程
        用了哪个版本的生成器语法"可见可控（partial 属性语法 8.4 起才有），仍建议写上。  -->
  <PropertyGroup>
    <RootNamespace>Piccolo.Forge.Sample.Mvvm</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.ExpUi/Piccolo.Forge.Themes.ExpUi.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Mvvm.CommunityToolkit/Piccolo.Forge.Mvvm.CommunityToolkit.csproj" />
  </ItemGroup>

</Project>
