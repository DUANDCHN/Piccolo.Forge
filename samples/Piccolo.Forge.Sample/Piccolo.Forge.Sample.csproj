<Project Sdk="Microsoft.NET.Sdk">

  <!--  ★ 控件演示：Avalonia 全部 89 个控件在本主题下的样子。★

        只引**一个**主题包（经典档）—— 控件模板两档共用，两档只有色板不同，
        所以控件演示一档就够；**外壳**两档差别很大（11 个模板文件无一相同），
        那才需要按档各出一个示例，见 Piccolo.Forge.Sample.ExpUi / .Islands。  -->
  <PropertyGroup>
    <RootNamespace>Piccolo.Forge.Sample</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!--  目录里 new 了 DataGrid / ColorPicker，需要控件本身；它们的**主题**是下面两个附加包。  -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.ExpUi/Piccolo.Forge.Themes.ExpUi.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Avalonia.DataGrid/Piccolo.Forge.Avalonia.DataGrid.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Avalonia.ColorPicker/Piccolo.Forge.Avalonia.ColorPicker.csproj" />
  </ItemGroup>

</Project>
