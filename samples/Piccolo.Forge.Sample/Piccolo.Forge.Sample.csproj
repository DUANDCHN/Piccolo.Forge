<Project Sdk="Microsoft.NET.Sdk">

  <!--  外壳（停靠 / 工具窗）的演示。★ 它是三个示例里**唯一引两个主题包**的一个，
        演示的是少数派接法：宿主两档都要、由设置切换（LDVision 就是这样）。
        默认姿势是**只引一个包** —— 见 Piccolo.Forge.Sample.ExpUi / .Islands。  -->

  <PropertyGroup>
    <RootNamespace>Piccolo.Forge.Sample</RootNamespace>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 不是对外 API，不强制 XML 注释 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Piccolo.Forge.Model/Piccolo.Forge.Model.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Mvvm/Piccolo.Forge.Mvvm.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Mvvm.CommunityToolkit/Piccolo.Forge.Mvvm.CommunityToolkit.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Avalonia/Piccolo.Forge.Avalonia.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.ExpUi/Piccolo.Forge.Themes.ExpUi.csproj" />
    <ProjectReference Include="../../src/Piccolo.Forge.Themes.Islands/Piccolo.Forge.Themes.Islands.csproj" />
  </ItemGroup>

</Project>
