<!--  ★ Forge 控件的主题（REQ-067）。★

      颜色一律走 {DynamicResource}，键名见 Piccolo.Forge.Themes/Themes/ForgeColors.axaml。
      宿主在自己的 ThemeDictionaries 里重定义同名键即可覆盖，且明暗各盖各的。

      ⚠ **底色为什么不放在模板里的 Border 上**（实机撞出来的，别再改回去）：
        Avalonia 里控件自身的 Render 画在**模板子元素之下**。这些控件的名字、自绘图标、
        标题文字都在 Render 里 —— 底色一旦做成模板里的 Border，
        选中态那块不透明的底就会把文字整个盖住（症状：选中的条带按钮只剩图标、底下的字没了；
        图标还在，是因为它是模板子元素）。
        所以这里只用 Setter 把**画刷**喂给控件，绘制仍由 Render 完成；
        模板只留一件事：放宿主图标控件的槽（ForgeIconHost）。

      ⚠ 控件**不能在构造里赋 Template**：那是 local value，会盖过这里的模板与 Setter，
        而且不报错。

      族（expUI / Islands）进键名 + :islands 伪类，明暗进 ThemeDictionaries
      —— Avalonia 的变体机制只认明暗。  -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:forge="clr-namespace:Piccolo.Forge.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="forge:ForgeStripeButton" x:Key="{x:Type forge:ForgeStripeButton}">
        <Setter Property="Background" Value="Transparent" />

        <!--  前景：图标与名字都用它。宿主塞进来的图标控件（Material.Icons 那类）默认**继承**
              Foreground，所以这一条同时管住了自绘图标、名字文字、和宿主的图标控件三者。
              漏了它的表现很难猜：浅色主题下一排看不见的白图标，而库自绘那套却是好的。  -->
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        <Setter Property="PressedBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonPressedBackground}" />
        <Setter Property="SelectedBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonSelectedBackground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeStripeButton">
                <!--  ★ 这个按钮的 Render 已经不画任何内容了（图标进了槽、名字是下面这个
                      TextBlock），所以底色可以回到模板里 —— 结构因此**真的可换**：
                      宿主重写这份模板就能改底色的形状、层次，甚至重排图标与文字。  -->
                <Panel Background="Transparent">
                    <Border
                        Background="{TemplateBinding BackgroundBrush}"
                        CornerRadius="{TemplateBinding ArcCornerRadius}"
                        Margin="{TemplateBinding BackgroundInsets}"
                        Name="PART_Background" />

                    <!--  图标：宿主给的控件、或画 Geometry 的子元素，位置都由槽按 IconRect 安排  -->
                    <forge:ForgeIconHost Name="PART_Icon" />

                    <!--  名字：⚠ **不能开 TextWrapping** —— 折行已经按上游规则
                          （第一个空格拆两段）在 NameText 里拼好了，
                          再让它按宽度自动换行会多切一刀，行数与量出来的高度就对不上。  -->
                    <TextBlock
                        FontSize="{TemplateBinding NameFontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="Stretch"
                        LineHeight="{TemplateBinding NameLineHeight}"
                        Margin="{TemplateBinding NameMargin}"
                        Name="PART_Name"
                        Text="{TemplateBinding NameText}"
                        TextAlignment="Center"
                        VerticalAlignment="Top" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  三档底色的**优先级不在这里定**（焦点 > 窗口可见 > 悬停 > 无，
              SquareStripeButton.kt:208-219），而在 ResolveBackgroundBrush 里 ——
              这里只负责把三个画刷各自喂进去。  -->

        <!--  激活时前景换一档（ToolWindow.Button.selectedForeground）  -->
        <Style Selector="^:toolwindow-active">
            <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonSelectedForeground}" />
        </Style>

        <!--  ── Islands 族：同样几档，换另一套键 ──  -->
        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-active">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonSelectedForeground}" />
        </Style>
        <Style Selector="^:islands">
            <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
            <Setter Property="PressedBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonPressedBackground}" />
            <Setter Property="SelectedBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonSelectedBackground}" />
        </Style>
    </ControlTheme>

    <!--  ── 条带上分组之间那条分隔线（StripeButtonSeparator.kt:22-32）──
          占位 32×11，线本身 24×1；位置照抄原来的算式（见 LineMargin 的注释，
          那个 y = 高/2 差半像素是上游的画法，别"修正"）。  -->
    <ControlTheme TargetType="forge:ForgeStripeSeparator" x:Key="{x:Type forge:ForgeStripeSeparator}">
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeStripeSeparator">
                <Panel>
                    <Border
                        Background="{DynamicResource Forge.ExpUi.StripeSeparator}"
                        HorizontalAlignment="Left"
                        Height="1"
                        Margin="{TemplateBinding LineMargin}"
                        Name="PART_Line"
                        VerticalAlignment="Top"
                        Width="24" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:drag-and-drop /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.StripeSeparatorDragAndDrop}" />
        </Style>
        <Style Selector="^:islands /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.StripeSeparator}" />
        </Style>
        <Style Selector="^:islands:drag-and-drop /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.StripeSeparatorDragAndDrop}" />
        </Style>
    </ControlTheme>

    <!--  ── 标题条右侧那排小按钮（⿴ 停靠 / ⋮ 选项 / — 收起）──
          悬停与按下同一个底色（ActionButton.hoverBackground）。
          ⚠ 圆角这里直接用 ForgeMetrics.HeaderButtonArc = 4 当**半径**，
            与条带按钮那边"Arc 是直径、要折半"的规矩不一致——照抄原实现，不在本需求里"顺手修正"，
            改它会改变现有观感，该单独判定对错。  -->
    <ControlTheme TargetType="forge:ForgeHeaderButton" x:Key="{x:Type forge:ForgeHeaderButton}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeHeaderButton">
                <!--  Render 只剩铺命中区，所以底色与图标都能放这里 —— 结构可换。
                      ⚠ 圆角 4 是直接当**半径**用的（ForgeMetrics.HeaderButtonArc），
                        与条带按钮那边"Arc 是直径、要折半"的规矩不一致 ——
                        照抄原实现，不在本需求里顺手修正。  -->
                <Panel Background="Transparent">
                    <Border
                        Background="{TemplateBinding HoverBackgroundBrush}"
                        CornerRadius="4"
                        IsVisible="False"
                        Name="PART_Background" />

                    <!--  图标位：16×16 居中（ForgeMetrics.HeaderButtonIconSize）  -->
                    <ContentPresenter
                        Height="16"
                        HorizontalAlignment="Center"
                        Name="PART_Icon"
                        VerticalAlignment="Center"
                        Width="16" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  悬停与按下同一个底色（原实现就是 IsPointerOver || IsPressed）  -->
        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Background">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
            <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
    </ControlTheme>

    <!--  ── 不套模板、只由主题给画笔的两个（REQ-067）──
          它们要么自己管着 VisualChildren（条带挂着两组按钮，ApplyTemplate 会把子元素清空），
          要么画的是"热区里居中的一条线"（分割线的抓取区 6px、线 1px），模板表达不了。
          对宿主而言用法完全一样：重定义同名键即可，明暗照常跟随 ——
          区别只在库内部是 Render 拿着画刷画，而不是模板里的 Border。  -->
    <ControlTheme TargetType="forge:ForgeToolWindowToolbar" x:Key="{x:Type forge:ForgeToolWindowToolbar}">
        <Setter Property="StripeBackgroundBrush" Value="{DynamicResource Forge.ExpUi.StripeBackground}" />
        <Setter Property="StripeBorderBrush" Value="{DynamicResource Forge.ExpUi.StripeBorder}" />

        <Style Selector="^:islands">
            <Setter Property="StripeBackgroundBrush" Value="{DynamicResource Forge.Islands.StripeBackground}" />
            <Setter Property="StripeBorderBrush" Value="{DynamicResource Forge.Islands.StripeBorder}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="forge:ForgeEditorSplitter" x:Key="{x:Type forge:ForgeEditorSplitter}">
        <Setter Property="LineBrush" Value="{DynamicResource Forge.ExpUi.EditorTabsBorder}" />

        <Style Selector="^:islands">
            <Setter Property="LineBrush" Value="{DynamicResource Forge.Islands.EditorTabsBorder}" />
        </Style>
    </ControlTheme>

    <!--  ── 「更多」按钮：与条带按钮同族（SquareStripeButton.kt:62-80 是兄弟），
          底色规则也一样（按钮矩形 − 图标内边距）。不可用时整块不画、也不吃鼠标。  -->
    <ControlTheme TargetType="forge:ForgeMoreButton" x:Key="{x:Type forge:ForgeMoreButton}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeMoreButton">
                <Panel Background="Transparent">
                    <Border
                        Background="{TemplateBinding BackgroundBrush}"
                        CornerRadius="{TemplateBinding ArcCornerRadius}"
                        Margin="{TemplateBinding BackgroundInsets}"
                        Name="PART_Background" />
                    <forge:ForgeIconHost Name="PART_Icon" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
            <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
    </ControlTheme>

    <!--  拖拽反馈层：落点方框与目标区高亮的位置每帧都变，模板表达不了 → 同样只给画笔  -->
    <ControlTheme TargetType="forge:ForgeDragOverlay" x:Key="{x:Type forge:ForgeDragOverlay}">
        <Setter Property="DropBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonDropBackground}" />
        <Setter Property="DropBorderBrush" Value="{DynamicResource Forge.ExpUi.ButtonDropBorder}" />
        <Setter Property="DropAreaBrush" Value="{DynamicResource Forge.ExpUi.DragAreaBackground}" />

        <Style Selector="^:islands">
            <Setter Property="DropBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonDropBackground}" />
            <Setter Property="DropBorderBrush" Value="{DynamicResource Forge.Islands.ButtonDropBorder}" />
            <Setter Property="DropAreaBrush" Value="{DynamicResource Forge.Islands.DragAreaBackground}" />
        </Style>
    </ControlTheme>

    <!--  ── 面板标题条上的内容标签（工具窗口模型.md §13.1）──
          悬停底铺满整块；选中时底边一条下划线，高 3、圆角直径 4（折半给 Avalonia）。
          窗口失焦时下划线换成 inactive 那档（ToolWindowTabPainter）。
          位置由 UnderlineMargin 给 —— 值仍出自 ComputeUnderlineRect，那里记着
          「工具窗口这一版整体下移 1 并减高」的出处。  -->
    <ControlTheme TargetType="forge:ForgeContentTab" x:Key="{x:Type forge:ForgeContentTab}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.ExpUi.HeaderTabHoverBackground}" />
        <Setter Property="UnderlineBrush" Value="{DynamicResource Forge.ExpUi.HeaderTabUnderline}" />
        <Setter Property="InactiveUnderlineBrush" Value="{DynamicResource Forge.ExpUi.HeaderTabInactiveUnderline}" />

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
            <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.Islands.HeaderTabHoverBackground}" />
            <Setter Property="UnderlineBrush" Value="{DynamicResource Forge.Islands.HeaderTabUnderline}" />
            <Setter Property="InactiveUnderlineBrush" Value="{DynamicResource Forge.Islands.HeaderTabInactiveUnderline}" />
        </Style>
    </ControlTheme>

    <!--  面板标题条：同样自己管着子控件（标签条 + 三个按钮），不套模板，只给画笔。
          文字色走 Foreground（标题自绘时取它）。  -->
    <ControlTheme TargetType="forge:ForgeToolWindowHeader" x:Key="{x:Type forge:ForgeToolWindowHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.Foreground}" />
        <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource Forge.ExpUi.HeaderBackground}" />
        <Setter Property="HeaderBorderBrush" Value="{DynamicResource Forge.ExpUi.HeaderBorder}" />

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.Foreground}" />
            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource Forge.Islands.HeaderBackground}" />
            <Setter Property="HeaderBorderBrush" Value="{DynamicResource Forge.Islands.HeaderBorder}" />
        </Style>
    </ControlTheme>

    <!--  ── 编辑区的文档标签 ──
          与内容标签不同，它**不套模板**：底与描边是 5 态 × 2 族，两族还是两个 painter
          （expUI 整条贴边 + 下划线；Islands 改画内缩圆角块、完全不画下划线），
          且若干状态的填充或描边是空。判定留在 C# 的 ResolveColors 里（每档带上游出处），
          这里只把颜色喂进去。宿主的用法不受影响：重定义同名键即可。  -->
    <ControlTheme TargetType="forge:ForgeEditorTab" x:Key="{x:Type forge:ForgeEditorTab}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.Foreground}" />
        <Setter Property="SelectedBackgroundBrush" Value="{DynamicResource Forge.ExpUi.EditorTabSelectedBackground}" />
        <Setter Property="SelectedBorderBrush" Value="{DynamicResource Forge.ExpUi.EditorTabSelectedBorder}" />
        <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.ExpUi.EditorTabHoverBackground}" />
        <Setter Property="InactiveSelectedBackgroundBrush" Value="{DynamicResource Forge.ExpUi.EditorTabInactiveSelectedBackground}" />
        <Setter Property="InactiveSelectedBorderBrush" Value="{DynamicResource Forge.ExpUi.EditorTabInactiveSelectedBorder}" />
        <Setter Property="UnderlineBrush" Value="{DynamicResource Forge.ExpUi.HeaderTabUnderline}" />
        <Setter Property="InactiveUnderlineBrush" Value="{DynamicResource Forge.ExpUi.HeaderTabInactiveUnderline}" />

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.Foreground}" />
            <Setter Property="SelectedBackgroundBrush" Value="{DynamicResource Forge.Islands.EditorTabSelectedBackground}" />
            <Setter Property="SelectedBorderBrush" Value="{DynamicResource Forge.Islands.EditorTabSelectedBorder}" />
            <Setter Property="HoverBackgroundBrush" Value="{DynamicResource Forge.Islands.EditorTabHoverBackground}" />
            <Setter Property="InactiveSelectedBackgroundBrush" Value="{DynamicResource Forge.Islands.EditorTabInactiveSelectedBackground}" />
            <Setter Property="InactiveSelectedBorderBrush" Value="{DynamicResource Forge.Islands.EditorTabInactiveSelectedBorder}" />
            <Setter Property="UnderlineBrush" Value="{DynamicResource Forge.Islands.HeaderTabUnderline}" />
            <Setter Property="InactiveUnderlineBrush" Value="{DynamicResource Forge.Islands.HeaderTabInactiveUnderline}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
