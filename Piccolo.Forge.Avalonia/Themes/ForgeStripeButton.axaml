<!--  ★ 条带按钮的模板（REQ-067 的第一片）。★

      在这之前，背景是 ForgeStripeButton.Render 里一句 DrawRectangle 画的，颜色只认 ForgePalette，
      宿主想改只能给一个 C# 回调。现在底色与圆角归这份模板，颜色走 {DynamicResource}，
      宿主在自己的 ThemeDictionaries 里重定义同名键就能盖过去，且明暗各盖各的。

      ⚠ 三条容易踩的：
        · 控件**不能在构造里给 Template 赋值** —— 那是 local value，会盖过这里；
        · 族（expUI / Islands）不进 ThemeDictionaries（它只认明暗），进**键名 + 伪类**：
          ForgeSquareButtonBase 按 Palette.Island 设 :islands，下面据此换一套键；
        · Margin / CornerRadius 绑的是控件上算好的 Avalonia 属性
          （BackgroundInsets / ArcCornerRadius）—— TemplateBinding 不认普通 C# 属性。

      背景那块矩形是「按钮矩形 − 图标内边距」，照抄上游
      SquareStripeButtonLook.kt:64-70 · paintBackground（它先减 insets 再减 iconPadding）。
      **显名时也是整块按钮、含名字那一截**（SquareStripeButton.kt:196-198），
      所以内缩只用 Margin 表达、不去砍高度。  -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:forge="clr-namespace:Piccolo.Forge.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="forge:ForgeStripeButton" x:Key="{x:Type forge:ForgeStripeButton}">
        <Setter Property="Background" Value="Transparent" />

        <!--  前景：图标与名字都用它。宿主塞进来的图标控件（Material.Icons 那类）默认**继承**
              Foreground，所以这一条同时管住了自绘图标、名字文字、和宿主的图标控件三者。
              漏了它的表现很难猜：浅色主题下一排看不见的白图标，而库自绘那套却是好的。  -->
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeStripeButton">
                <Panel Background="Transparent">
                    <!--  底色那层：默认不画（Transparent），四个状态由下面的样式换色  -->
                    <Border
                        CornerRadius="{TemplateBinding ArcCornerRadius}"
                        Margin="{TemplateBinding BackgroundInsets}"
                        Name="PART_Background" />

                    <!--  宿主给的图标控件挂这里；位置由它回头问按钮要（见 ForgeIconHost）  -->
                    <forge:ForgeIconHost Name="PART_Icon" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  ── 状态色。优先级照抄 SquareStripeButton.kt:208-219 · getBackgroundColor：
              焦点 > 窗口可见 > 悬停 > 无。
              ⚠ 次序在 XAML 里是「后面的赢」，所以要从弱到强写：hover → visible → active。
              别按阅读顺序写成 active 在前 —— 那样鼠标划过一个已打开的面板按钮时
              会显示 hover 色，而上游那里显示的是 pressed 色。  ──  -->
        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:toolwindow-visible /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonPressedBackground}" />
        </Style>
        <Style Selector="^:toolwindow-active /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonSelectedBackground}" />
        </Style>

        <!--  激活时前景换一档（ToolWindow.Button.selectedForeground）  -->
        <Style Selector="^:toolwindow-active">
            <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonSelectedForeground}" />
        </Style>

        <!--  ── Islands 族：同样几档，换另一套键 ──  -->
        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-active">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonSelectedForeground}" />
        </Style>
        <Style Selector="^:islands:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-visible /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonPressedBackground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-active /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonSelectedBackground}" />
        </Style>
    </ControlTheme>

    <!--  ── 条带上分组之间那条分隔线（StripeButtonSeparator.kt:22-32）──
          占位 32×11，线本身 24×1；位置照抄原来的算式（见 LineMargin 的注释，
          那个 y = 高/2 差半像素是上游的画法，别"修正"）。  -->
    <ControlTheme TargetType="forge:ForgeStripeSeparator" x:Key="{x:Type forge:ForgeStripeSeparator}">
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeStripeSeparator">
                <Panel>
                    <Border
                        Background="{DynamicResource Forge.ExpUi.StripeSeparator}"
                        HorizontalAlignment="Left"
                        Height="1"
                        Margin="{TemplateBinding LineMargin}"
                        Name="PART_Line"
                        VerticalAlignment="Top"
                        Width="24" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:drag-and-drop /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.StripeSeparatorDragAndDrop}" />
        </Style>
        <Style Selector="^:islands /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.StripeSeparator}" />
        </Style>
        <Style Selector="^:islands:drag-and-drop /template/ Border#PART_Line">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.StripeSeparatorDragAndDrop}" />
        </Style>
    </ControlTheme>

    <!--  ── 标题条右侧那排小按钮（⿴ 停靠 / ⋮ 选项 / — 收起）──
          悬停与按下同一个底色（ActionButton.hoverBackground）。
          ⚠ 圆角这里直接用 ForgeMetrics.HeaderButtonArc = 4 当**半径**，
            与条带按钮那边"Arc 是直径、要折半"的规矩不一致——照抄原实现，不在本需求里"顺手修正"，
            改它会改变现有观感，该单独判定对错。  -->
    <ControlTheme TargetType="forge:ForgeHeaderButton" x:Key="{x:Type forge:ForgeHeaderButton}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeHeaderButton">
                <Panel Background="Transparent">
                    <Border CornerRadius="4" Name="PART_Background" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        </Style>

        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
        </Style>
        <Style Selector="^:islands:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:islands:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
    </ControlTheme>

    <!--  ── 不套模板、只由主题给画笔的两个（REQ-067）──
          它们要么自己管着 VisualChildren（条带挂着两组按钮，ApplyTemplate 会把子元素清空），
          要么画的是"热区里居中的一条线"（分割线的抓取区 6px、线 1px），模板表达不了。
          对宿主而言用法完全一样：重定义同名键即可，明暗照常跟随 ——
          区别只在库内部是 Render 拿着画刷画，而不是模板里的 Border。  -->
    <ControlTheme TargetType="forge:ForgeToolWindowToolbar" x:Key="{x:Type forge:ForgeToolWindowToolbar}">
        <Setter Property="StripeBackgroundBrush" Value="{DynamicResource Forge.ExpUi.StripeBackground}" />
        <Setter Property="StripeBorderBrush" Value="{DynamicResource Forge.ExpUi.StripeBorder}" />

        <Style Selector="^:islands">
            <Setter Property="StripeBackgroundBrush" Value="{DynamicResource Forge.Islands.StripeBackground}" />
            <Setter Property="StripeBorderBrush" Value="{DynamicResource Forge.Islands.StripeBorder}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="forge:ForgeEditorSplitter" x:Key="{x:Type forge:ForgeEditorSplitter}">
        <Setter Property="LineBrush" Value="{DynamicResource Forge.ExpUi.EditorTabsBorder}" />

        <Style Selector="^:islands">
            <Setter Property="LineBrush" Value="{DynamicResource Forge.Islands.EditorTabsBorder}" />
        </Style>
    </ControlTheme>

    <!--  ── 「更多」按钮：与条带按钮同族（SquareStripeButton.kt:62-80 是兄弟），
          底色规则也一样（按钮矩形 − 图标内边距）。不可用时整块不画、也不吃鼠标。  -->
    <ControlTheme TargetType="forge:ForgeMoreButton" x:Key="{x:Type forge:ForgeMoreButton}">
        <Setter Property="Foreground" Value="{DynamicResource Forge.ExpUi.ButtonForeground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeMoreButton">
                <Panel Background="Transparent">
                    <Border
                        CornerRadius="{TemplateBinding ArcCornerRadius}"
                        Margin="{TemplateBinding BackgroundInsets}"
                        Name="PART_Background" />
                    <forge:ForgeIconHost Name="PART_Icon" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:islands">
            <Setter Property="Foreground" Value="{DynamicResource Forge.Islands.ButtonForeground}" />
        </Style>
        <Style Selector="^:islands:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
