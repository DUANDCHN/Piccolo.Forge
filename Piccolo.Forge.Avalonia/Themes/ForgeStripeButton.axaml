<!--  ★ 条带按钮的模板（REQ-067 的第一片）。★

      在这之前，背景是 ForgeStripeButton.Render 里一句 DrawRectangle 画的，颜色只认 ForgePalette，
      宿主想改只能给一个 C# 回调。现在底色与圆角归这份模板，颜色走 {DynamicResource}，
      宿主在自己的 ThemeDictionaries 里重定义同名键就能盖过去，且明暗各盖各的。

      ⚠ 三条容易踩的：
        · 控件**不能在构造里给 Template 赋值** —— 那是 local value，会盖过这里；
        · 族（expUI / Islands）不进 ThemeDictionaries（它只认明暗），进**键名 + 伪类**：
          ForgeSquareButtonBase 按 Palette.Island 设 :islands，下面据此换一套键；
        · Margin / CornerRadius 绑的是控件上算好的 Avalonia 属性
          （BackgroundInsets / ArcCornerRadius）—— TemplateBinding 不认普通 C# 属性。

      背景那块矩形是「按钮矩形 − 图标内边距」，照抄上游
      SquareStripeButtonLook.kt:64-70 · paintBackground（它先减 insets 再减 iconPadding）。
      **显名时也是整块按钮、含名字那一截**（SquareStripeButton.kt:196-198），
      所以内缩只用 Margin 表达、不去砍高度。  -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:forge="clr-namespace:Piccolo.Forge.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="forge:ForgeStripeButton" x:Key="{x:Type forge:ForgeStripeButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="forge:ForgeStripeButton">
                <Panel Background="Transparent">
                    <!--  底色那层：默认不画（Transparent），四个状态由下面的样式换色  -->
                    <Border
                        CornerRadius="{TemplateBinding ArcCornerRadius}"
                        Margin="{TemplateBinding BackgroundInsets}"
                        Name="PART_Background" />

                    <!--  宿主给的图标控件挂这里；位置由它回头问按钮要（见 ForgeIconHost）  -->
                    <forge:ForgeIconHost Name="PART_Icon" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  ── 状态色。优先级照抄 SquareStripeButton.kt:208-219 · getBackgroundColor：
              焦点 > 窗口可见 > 悬停 > 无。
              ⚠ 次序在 XAML 里是「后面的赢」，所以要从弱到强写：hover → visible → active。
              别按阅读顺序写成 active 在前 —— 那样鼠标划过一个已打开的面板按钮时
              会显示 hover 色，而上游那里显示的是 pressed 色。  ──  -->
        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:toolwindow-visible /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonPressedBackground}" />
        </Style>
        <Style Selector="^:toolwindow-active /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.ExpUi.ButtonSelectedBackground}" />
        </Style>

        <!--  ── Islands 族：同样三档，换另一套键 ──  -->
        <Style Selector="^:islands:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-visible /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonPressedBackground}" />
        </Style>
        <Style Selector="^:islands:toolwindow-active /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource Forge.Islands.ButtonSelectedBackground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
