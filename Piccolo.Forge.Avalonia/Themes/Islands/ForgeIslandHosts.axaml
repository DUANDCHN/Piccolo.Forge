<!--  ★ 两个"岛的宿主"：外框（ForgeControl）与编辑区（ForgeEditorControl）。★

      它们**不套模板**（各自在代码里建整棵树），这里只做一件事：
      把岛那圈描边的画刷从资源键喂进去，由 ForgeIslandDecor 画。

      为什么单独一份而不是塞进某个控件的文件：这两个是**宿主级容器**，不是那 10 个控件之一；
      它们共用同一个键，写在一起才看得出"岛的外框只有这一处颜色"。

      ⚠ expUI 那一档 IslandBorder **不参与绘制**（非岛形态走 WindowBorder，见 ForgeIslandDecor），
        这里仍然给它一个值：默认字典必须是完整的一份，宿主可以只覆盖其中一个族。

      共同的规矩见本目录 Theme.axaml 的开头。  -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:forge="clr-namespace:Piccolo.Forge.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="forge:ForgeControl" x:Key="{x:Type forge:ForgeControl}">
        <Setter Property="IslandBorderBrush" Value="{DynamicResource Forge.Islands.IslandBorder}" />
        <!--  同一条边上两块面板之间那条 1px 线。归键的理由见 ForgeControl.DockDividerBrush：
              它原先直接取 Palette.WindowBorder，而那个值没有资源键，宿主够不着。  -->
        <Setter Property="DockDividerBrush" Value="{DynamicResource Forge.Islands.WindowBorder}" />
    </ControlTheme>

    <!--  编辑区比外框多一样：**它自己的底色**。归了键之后，宿主想让编辑区与面板同色
          （内容常是一整块空画布时，上游那"深一档"会读成黑洞）只需重定义同名键，
          不必去动库里的配色。null 兜底回 ForgePalette.EditorBackground，见那个属性的说明。  -->
    <ControlTheme TargetType="forge:ForgeEditorControl" x:Key="{x:Type forge:ForgeEditorControl}">
        <Setter Property="IslandBorderBrush" Value="{DynamicResource Forge.Islands.IslandBorder}" />
        <Setter Property="EditorBackgroundBrush" Value="{DynamicResource Forge.Islands.EditorBackground}" />
    </ControlTheme>
</ResourceDictionary>
