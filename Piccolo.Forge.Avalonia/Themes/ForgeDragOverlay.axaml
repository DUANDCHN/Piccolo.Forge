<!--  ★ 拖拽反馈层。★ **不套模板**：只由主题给画笔。
      它画的是拖拽中**实时算出来的**落点方框与目标区高亮，位置每帧都变，静态模板表达不了。

      共同的规矩见同目录 ForgeTheme.axaml 的开头。  -->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:forge="clr-namespace:Piccolo.Forge.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="forge:ForgeDragOverlay" x:Key="{x:Type forge:ForgeDragOverlay}">
        <Setter Property="DropBackgroundBrush" Value="{DynamicResource Forge.ExpUi.ButtonDropBackground}" />
        <Setter Property="DropBorderBrush" Value="{DynamicResource Forge.ExpUi.ButtonDropBorder}" />
        <Setter Property="DropAreaBrush" Value="{DynamicResource Forge.ExpUi.DragAreaBackground}" />

        <Style Selector="^:islands">
            <Setter Property="DropBackgroundBrush" Value="{DynamicResource Forge.Islands.ButtonDropBackground}" />
            <Setter Property="DropBorderBrush" Value="{DynamicResource Forge.Islands.ButtonDropBorder}" />
            <Setter Property="DropAreaBrush" Value="{DynamicResource Forge.Islands.DragAreaBackground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
