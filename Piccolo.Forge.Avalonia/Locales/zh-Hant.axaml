<!--  Forge 文案：繁体中文。
      键名 Forge.Strings.*，与颜色键同一套机制：控件 / 菜单按键取值，宿主在自己的资源里重定义同名键即可覆盖。
      由 ForgeThemeManager.ApplyLocale 按 CultureInfo 挑一份挂进 Application.Resources.MergedDictionaries。  -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="Forge.Strings.MoveTo">移至</x:String>
    <x:String x:Key="Forge.Strings.ViewMode">檢視模式</x:String>
    <x:String x:Key="Forge.Strings.RemoveFromSidebar">從側邊欄移除</x:String>
    <x:String x:Key="Forge.Strings.ShowToolWindowNames">顯示工具視窗名稱</x:String>
    <x:String x:Key="Forge.Strings.ViewModeDockPinned">停靠固定</x:String>
    <x:String x:Key="Forge.Strings.ViewModeDockUnpinned">停靠不固定</x:String>
    <x:String x:Key="Forge.Strings.ViewModeUndock">取消停靠</x:String>
    <x:String x:Key="Forge.Strings.ViewModeFloat">浮動</x:String>
    <x:String x:Key="Forge.Strings.ViewModeWindow">視窗</x:String>
    <x:String x:Key="Forge.Strings.SideLeft">左側</x:String>
    <x:String x:Key="Forge.Strings.SideRight">右側</x:String>
    <x:String x:Key="Forge.Strings.SideBottom">底部</x:String>
    <x:String x:Key="Forge.Strings.SideTop">頂部</x:String>
    <x:String x:Key="Forge.Strings.HalfTop">上半</x:String>
    <x:String x:Key="Forge.Strings.HalfBottom">下半</x:String>
    <x:String x:Key="Forge.Strings.HalfLeft">左半</x:String>
    <x:String x:Key="Forge.Strings.HalfRight">右半</x:String>
    <x:String x:Key="Forge.Strings.LocationFormat">{0} · {1}</x:String>
    <x:String x:Key="Forge.Strings.MoveToFormat">移至 {0}</x:String>
    <x:String x:Key="Forge.Strings.CloseTab">關閉</x:String>
    <x:String x:Key="Forge.Strings.CloseOtherTabs">關閉其他分頁</x:String>
    <x:String x:Key="Forge.Strings.CloseAllTabs">關閉所有分頁</x:String>
    <x:String x:Key="Forge.Strings.CloseTabsToTheLeft">關閉左側分頁</x:String>
    <x:String x:Key="Forge.Strings.CloseTabsToTheRight">關閉右側分頁</x:String>
    <x:String x:Key="Forge.Strings.SplitRight">向右分割</x:String>
    <x:String x:Key="Forge.Strings.SplitAndMoveRight">分割並右移</x:String>
    <x:String x:Key="Forge.Strings.SplitDown">向下分割</x:String>
    <x:String x:Key="Forge.Strings.SplitAndMoveDown">分割並下移</x:String>
    <x:String x:Key="Forge.Strings.PinTab">固定分頁</x:String>
    <x:String x:Key="Forge.Strings.OpenTabInNewWindow">在新視窗中開啟分頁</x:String>
    <x:String x:Key="Forge.Strings.DockButton">停靠</x:String>
    <x:String x:Key="Forge.Strings.OptionsButton">選項</x:String>
    <x:String x:Key="Forge.Strings.HideButton">隱藏</x:String>
    <x:String x:Key="Forge.Strings.MoreToolWindows">更多工具視窗</x:String>
    <x:String x:Key="Forge.Strings.CloseTabFormat">關閉 {0}</x:String>
</ResourceDictionary>
